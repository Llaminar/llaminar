# Device-free replay through the actual cache destructor and context boundary.
# Include after v2_test_forward_graph_types has been declared.
add_v2_test(V2_Integration_ForwardGraphCacheOwnerLifetimeReplay
    COMMAND $<TARGET_FILE:v2_test_forward_graph_types>
        --gtest_filter=Test__GraphSegmentCache.FirstCaptureInvokesBoundaryAfterEventHandoff:Test__GraphSegmentCache.UnselectedSnapshotOutputKeepsPreparedHelperExecutable:Test__GraphSegmentCache.RetainedParentOwnsTransactionZeroAndSteadyReplay:Test__GraphSegmentCache.RetainedParentSetupMaterializationDefersTransactionZeroLaunch:Test__GraphSegmentCache.RetainedParentServicesCertifiedManualTicketAfterSingleLaunch:Test__GraphSegmentCache.SegmentedRootSetupMaterializationDefersManualBoundaryAndLaunch:Test__GraphSegmentCache.SegmentedManualCollectiveReplayUsesCacheOwnedSnapshotManifest:Test__GraphSegmentCache.PassiveCaptureWaveJoinsAfterActiveTransactionZeroLaunch:Test__GraphSegmentCache.LaunchDependencyRunsAfterCaptureAndImmediatelyBeforeEveryLaunch:Test__GraphSegmentCache.HeterogeneousTicketEnvelopeRequiresCapturedManualCapturedLifecycle:Test__GraphSegmentCache.HeterogeneousTicketLaunchDependencyArmsOnceBeforeProducer
    LABELS "V2;Integration;ProductionTestPreflight;DeviceFree;GraphCapture;Lifecycle;Ownership;Replay;Regression"
    MPI_PROCS 1 NO_MPI NO_MODELS TIMEOUT 60
    ENVIRONMENT "LLAMINAR_FORCE_CPU_ONLY_STARTUP=1")
list(APPEND V2_PRODUCTION_TEST_PREFLIGHT_TESTS
    V2_Integration_ForwardGraphCacheOwnerLifetimeReplay)
