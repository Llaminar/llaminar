# @file V2GPUProcessTestEntryPolicy.cmake
# @brief Bind core-linked default GTest entries to the lexical runtime owner.
# Inspect the actual target graph, not filenames or GPU-looking test labels.
# Runtime-independent tests retain upstream GTest main and their lean closure.

function(v2_canonical_link_target TARGET_NAME RESULT)
    if(NOT TARGET "${TARGET_NAME}")
        set(${RESULT} "" PARENT_SCOPE)
        return()
    endif()
    get_target_property(_alias "${TARGET_NAME}" ALIASED_TARGET)
    if(_alias)
        set(${RESULT} "${_alias}" PARENT_SCOPE)
    else()
        set(${RESULT} "${TARGET_NAME}" PARENT_SCOPE)
    endif()
endfunction()

function(v2_target_links_target START_TARGET REQUIRED_TARGET RESULT)
    v2_canonical_link_target("${REQUIRED_TARGET}" _required)
    set(_pending "${START_TARGET}")
    set(_visited "")
    while(_pending)
        list(POP_FRONT _pending _target)
        v2_canonical_link_target("${_target}" _target)
        if(_target IN_LIST _visited OR NOT TARGET "${_target}")
            continue()
        endif()
        if(_target STREQUAL _required)
            set(${RESULT} TRUE PARENT_SCOPE)
            return()
        endif()
        list(APPEND _visited "${_target}")
        foreach(_property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(_links "${_target}" "${_property}")
            if(NOT _links)
                continue()
            endif()
            foreach(_link IN LISTS _links)
                # Static-library private dependencies use this standard wrapper.
                if(_link MATCHES "^\\$<LINK_ONLY:([^<>]+)>$")
                    set(_link "${CMAKE_MATCH_1}")
                endif()
                if(TARGET "${_link}")
                    list(APPEND _pending "${_link}")
                endif()
            endforeach()
        endforeach()
    endwhile()
    set(${RESULT} FALSE PARENT_SCOPE)
endfunction()

function(v2_bind_gpu_process_test_entry TARGET_NAME ENTRY_TARGET)
    get_target_property(_type "${TARGET_NAME}" TYPE)
    if(NOT _type STREQUAL "EXECUTABLE")
        return()
    endif()
    get_target_property(_links "${TARGET_NAME}" LINK_LIBRARIES)
    get_target_property(_existing_entry "${TARGET_NAME}" V2_GPU_PROCESS_ENTRY)
    if(_existing_entry)
        if(NOT _existing_entry STREQUAL ENTRY_TARGET OR
           NOT "${ENTRY_TARGET}" IN_LIST _links)
            message(FATAL_ERROR "Conflicting GPU process entry for ${TARGET_NAME}")
        endif()
        return()
    endif()
    v2_target_links_target("${TARGET_NAME}" GTest::gtest_main _uses_default_main)
    if(NOT _uses_default_main)
        return() # A custom entry owns its explicit lexical scope in source.
    endif()
    v2_target_links_target("${TARGET_NAME}" llaminar2_core _uses_core)
    if(NOT _uses_core)
        return()
    endif()
    if(NOT TARGET "${ENTRY_TARGET}")
        message(FATAL_ERROR "Missing canonical core GTest entry: ${ENTRY_TARGET}")
    endif()
    v2_canonical_link_target(GTest::gtest_main _default_main)
    set(_replacement "")
    set(_replaced FALSE)
    foreach(_link IN LISTS _links)
        v2_canonical_link_target("${_link}" _canonical)
        if(_canonical STREQUAL _default_main)
            list(APPEND _replacement "${ENTRY_TARGET}")
            set(_replaced TRUE)
        else()
            list(APPEND _replacement "${_link}")
        endif()
    endforeach()
    if(NOT _replaced)
        # A transitive default-main archive cannot be edited globally without
        # changing its other consumers. Resolve main from the canonical archive
        # first; the transitive archive then contributes no upstream main object.
        list(PREPEND _replacement "${ENTRY_TARGET}")
    endif()
    set_property(TARGET "${TARGET_NAME}" PROPERTY LINK_LIBRARIES "${_replacement}")
    set_property(TARGET "${TARGET_NAME}" PROPERTY V2_GPU_PROCESS_ENTRY "${ENTRY_TARGET}")
endfunction()

function(v2_bind_gpu_process_test_directory DIRECTORY_NAME ENTRY_TARGET)
    get_property(_targets DIRECTORY "${DIRECTORY_NAME}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(_target IN LISTS _targets)
        v2_bind_gpu_process_test_entry("${_target}" "${ENTRY_TARGET}")
    endforeach()
    get_property(_children DIRECTORY "${DIRECTORY_NAME}" PROPERTY SUBDIRECTORIES)
    foreach(_child IN LISTS _children)
        v2_bind_gpu_process_test_directory("${_child}" "${ENTRY_TARGET}")
    endforeach()
endfunction()
