# Canonical ROCm user-space release and matching source revisions.
# Installers, dependency receipts and image tags consume this file. The host
# kernel driver is a separate dependency and must never be changed here.
LLAMINAR_ROCM_VERSION=10.1.0
LLAMINAR_ROCM_SERIES=10.1
LLAMINAR_ROCM_DEB_VERSION=10.1.0-3
LLAMINAR_ROCM_SDK_PREFIX=/opt/rocm/core-10.1
LLAMINAR_ROCM_ACTIVE_PREFIX=/opt/rocm-sdk
LLAMINAR_ROCM_SYSTEMS_REVISION=7da43026e4f2ef7600433c38c820732f7a205d22
LLAMINAR_ROCM_LIBRARIES_REVISION=39d8d60365d2272a5366f76ccb3bfba24b219eaf
LLAMINAR_HIP_LIBRARY_VERSION=7.16.26385
LLAMINAR_HIP_BUILD_ID=26385
# ROCr retains its release ABI with explicit helper-NUMA and deferred SDMA profiling repairs.
LLAMINAR_ROCR_LIBRARY_VERSION=1.21.0
# Canonical shipping device-code targets; CMake and dependency installers share
# this declaration. Explicit local selections remain supported, not certified.
LLAMINAR_ROCM_GPU_TARGETS='gfx906;gfx1100'
# The SDK compiler and narrow full-LTO allocation-record/GVN-diagnostic repairs.
# This builder-only linker preserves parallel codegen; runtime images need no compiler.
LLAMINAR_ROCM_LLVM_REVISION=d6f6cb691863e9258034ab48c1dfce21689d5606
LLAMINAR_ROCM_LLVM_LTO_BACKEND_SHA256=18ee96afa8b3bc13ed5f22f04164b1b3e7bc65e064c044737cb3c74fa8115c23
LLAMINAR_ROCM_LLVM_LLD_DRIVER_SHA256=f35f6cf82397874b3b1e149b8e3986fbe50ecee449eda601fbc2ec5f21e999a0
LLAMINAR_ROCM_LLVM_GVN_SOURCE_SHA256=6de3ceb095cc0669b5b9f61afcaa0a281c7c669d3479bd2a20fdef171302113c
LLAMINAR_ROCM_LLVM_GVN_PATCH_SHA256=80c4c2104866e7bbe74be5c264d16d49e45b7ce99bd2c6f5e53d0323c46b5ab7
LLAMINAR_ROCM_LTO_LINKER_PREFIX=/opt/llaminar/llvm-lto-linker
