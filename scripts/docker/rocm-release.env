# Canonical ROCm user-space release and matching source revisions.
# Installers, dependency receipts and image tags consume this file. The host
# kernel driver is a separate dependency and must never be changed here.
LLAMINAR_ROCM_VERSION=10.0.0
LLAMINAR_ROCM_SERIES=10.0
LLAMINAR_ROCM_DEB_VERSION=10.0.0-4
LLAMINAR_ROCM_SDK_PREFIX=/opt/rocm/core-10.0
LLAMINAR_ROCM_ACTIVE_PREFIX=/opt/rocm-sdk
LLAMINAR_ROCM_SYSTEMS_REVISION=6b0e43f341195e203754e08f850e437ff2fc09f9
LLAMINAR_ROCM_LIBRARIES_REVISION=8d1ae90eff7d022f26019ec55b2ec6a7674b3112
LLAMINAR_HIP_LIBRARY_VERSION=7.15.26333
LLAMINAR_HIP_BUILD_ID=26333
