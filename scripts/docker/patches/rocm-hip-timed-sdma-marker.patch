+bool DmaBlitManager::submitTimingMarker(void* host_destination, const void* device_source,
+                                        size_t bytes) const {
+  if (host_destination == nullptr || device_source == nullptr || bytes == 0 ||
+      gpu().timestamp() == nullptr) {
+    return false;
+  }
+  hsa_agent_t source_agent = dev().getBackendDevice();
+  hsa_agent_t destination_agent = dev().getCpuAgent();
+  amd::CopyMetadata metadata(true, amd::CopyMetadata::CopyEnginePreference::SDMA);
+  return rocrCopyBuffer(reinterpret_cast<address>(host_destination), destination_agent,
+                        reinterpret_cast<const_address>(device_source), source_agent,
+                        bytes, metadata);
+}
