@@ -0,0 +1,52 @@
+/**
+ * @file SmallAllGatherPolicy.cpp
+ * @brief Validate exact live bytes and commit one original eligible LL preference.
+ *
+ * All validation precedes the first write. No payload hashes, diagnostic cost
+ * fingerprints, strings, allocation, device API or retained state enter native
+ * planning, and the original channel output is never changed.
+ */
+#include "SmallAllGatherPolicy.h"
+#include <cmath>
+#include <limits>
+
+namespace llaminar::collective
+{
+    ncclResult_t preferSmallAllGatherLL(std::size_t ranks, std::size_t nodes,
+        ncclFunc_t collective, std::size_t bytes, float **costs,
+        int algorithms, int protocols, int *channels) noexcept
+    {
+        if (ranks < 2 || nodes != 1 || !costs || !channels ||
+            algorithms != NCCL_NUM_ALGORITHMS || protocols != NCCL_NUM_PROTOCOLS ||
+            collective < ncclFuncBroadcast || collective >= ncclNumFuncs)
+            return ncclInvalidArgument;
+        auto *table = reinterpret_cast<float *>(costs);
+        if (collective != ncclFuncAllGather) return ncclSuccess;
+        if (bytes % ranks != 0) return ncclInvalidArgument;
+        if (bytes == 0 || bytes / ranks > kSmallAllGatherMaximumPerRankBytes)
+            return ncclSuccess;
+        int selected = NCCL_ALGO_UNDEF;
+        float selected_cost = std::numeric_limits<float>::infinity();
+        for (int algorithm = 0; algorithm < algorithms; ++algorithm)
+            for (int protocol = 0; protocol < protocols; ++protocol)
+            {
+                const float value = table[algorithm * protocols + protocol];
+                if (value == NCCL_ALGO_PROTO_IGNORE) continue;
+                if (!std::isfinite(value) || value < 0.0f) return ncclInvalidArgument;
+                if (protocol == NCCL_PROTO_LL && value < selected_cost)
+                {
+                    selected = algorithm;
+                    selected_cost = value;
+                }
+            }
+        if (selected == NCCL_ALGO_UNDEF) return ncclInvalidUsage;
+        // No error can occur after this first write. Preserve every ignored
+        // entry and the original native algorithm-order tie resolution.
+        const auto selected_index = selected * protocols + NCCL_PROTO_LL;
+        for (std::size_t index = 0; index < NCCL_NUM_ALGORITHMS * NCCL_NUM_PROTOCOLS; ++index)
+            if (static_cast<int>(index) != selected_index && table[index] == 0.0f)
+                table[index] = std::numeric_limits<float>::min();
+        table[selected_index] = 0.0f;
+        return ncclSuccess;
+    }
+}
diff --git a/src/SmallAllGatherPolicy.h b/src/SmallAllGatherPolicy.h
new file mode 100644
--- /dev/null
+++ b/src/SmallAllGatherPolicy.h
@@ -0,0 +1,40 @@
+/**
+ * @file SmallAllGatherPolicy.h
+ * @brief Pure native preference for eligible small-AllGather LL costs.
+ *
+ * Native communicators own admission; the vendor owns enums, eligible masks,
+ * channel geometry, payloads and progress. This function only validates and
+ * updates the supplied cold planning table, without retaining state.
+ */
+#pragma once
+#include "nccl_tuner.h"
+#include <cstddef>
+
+namespace llaminar::collective
+{
+    inline constexpr std::size_t kSmallAllGatherMaximumPerRankBytes = 16 * 1024;
+
+    /**
+     * @brief Prefer the original minimum eligible LL pair for a small AllGather.
+     * @param ranks Original communicator rank count, at least two.
+     * @param nodes Original communicator node count, exactly one for this policy.
+     * @param collective Actual vendor collective enum.
+     * @param bytes Live vendor maximum send/receive bytes, rank-expanded for AllGather.
+     * @param costs Original flat contiguous matrix in the vendor float** ABI.
+     * @param algorithms Actual row count, equal to NCCL_NUM_ALGORITHMS.
+     * @param protocols Actual column count, equal to NCCL_NUM_PROTOCOLS.
+     * @param channels Original channel output, validated but never modified.
+     * @return Original vendor success/error; every failure precedes any write.
+     *
+     * Other collectives, zero and messages above16KiB per rank preserve all cost
+     * bits. Targeted input must normalize exactly and contain finite nonnegative
+     * eligible costs and an eligible LL pair. Ignored pairs remain ignored. The
+     * minimum original LL cost wins, retaining native algorithm-order ties.
+     * Its exact positive zero becomes unique after other eligible signed zeros
+     * become the minimum normal positive float. Original native postpasses remain
+     * the caller's authority. No diagnostic, logging or environment work occurs.
+     */
+    [[nodiscard]] ncclResult_t preferSmallAllGatherLL(std::size_t ranks, std::size_t nodes,
+        ncclFunc_t collective, std::size_t bytes, float **costs,
+        int algorithms, int protocols, int *channels) noexcept;
+}
