--- /dev/null
+++ b/src/include/llaminar_small_allgather_scope.h
@@ -0,0 +1,117 @@
+/**
+ * @file llaminar_small_allgather_scope.h
+ * @brief Native communicator facts admitting the qualified small-AllGather policy.
+ *
+ * Initialization freezes this decision in the communicator that owns its
+ * topology and configuration. No application shadow, environment read, device
+ * probe, mutable process-global cache or payload/count authority is introduced.
+ */
+#ifndef LLAMINAR_SMALL_ALLGATHER_SCOPE_H_
+#define LLAMINAR_SMALL_ALLGATHER_SCOPE_H_
+
+#include "comm.h"
+#include "graph/topo.h"
+#include "archinfo.h"
+#include "transport.h"
+
+/**
+ * @brief Admit only the homogeneous single-process gfx906 TP4/default-CTA scope.
+ * @param comm Fully initialized original communicator and final native topology.
+ * @param nativeSelectorsAbsent Existing selector presence, sampled only at init.
+ * @return Whether this communicator may apply the native small-AllGather policy.
+ *
+ * Every native rank must occur exactly once among the four local topology GPUs.
+ * Called only after the original blocking InitAll joins every initializer.
+ * External plugins retain their original branch and lifecycle. Other native
+ * configurations remain their own existing policies; they are not admitted to
+ * this specialization. Four original connected SHM/direct/direct channels are
+ * required; no claim about unobserved PCIe bandwidth/physical layout is made.
+ * No eligibility decision is inferred from device zero.
+ */
+static inline bool llaminarSmallAllGatherScope(const ncclComm* comm, bool nativeSelectorsAbsent) {
+  if (comm == nullptr || !nativeSelectorsAbsent || comm->tuner != nullptr ||
+      comm->nRanks != 4 || comm->nNodes != 1 || comm->localRanks != 4 ||
+      comm->intraRanks != 4 || comm->config.blocking != 1 || comm->initState != ncclSuccess ||
+      comm->config.CTAPolicy != NCCL_CTA_POLICY_DEFAULT ||
+      comm->topo == nullptr || comm->topo->nodes[GPU].count != 4 ||
+      (comm->topo->type & RCCL_TOPO_XGMI_ALL) != 0 || comm->runtimeConn ||
+      comm->useIntraNet || comm->nChannels != 4) return false;
+  unsigned ranks = 0;
+  for (int index = 0; index < 4; ++index) {
+    const auto& gpu = comm->topo->nodes[GPU].nodes[index].gpu;
+    if (gpu.rank < 0 || gpu.rank >= 4 || (ranks & (1u << gpu.rank)) != 0 ||
+        !IsArchMatch(gpu.gcn, "gfx906") ||
+        (gpu.gcn[6] != '\0' && gpu.gcn[6] != ':')) return false;
+    ranks |= 1u << gpu.rank;
+  }
+  if (ranks != 15u) return false;
+  // The measured native domain uses already connected SHM/direct/direct rings.
+  // Inspect original endpoint metadata only; no topology guess or device query.
+  for (int channel = 0; channel < comm->nChannels; ++channel) {
+    const auto& ring = comm->channels[channel].ring;
+    const auto* peers = comm->channels[channel].peers;
+    if (peers == nullptr || ring.prev < 0 || ring.prev >= 4 || ring.next < 0 || ring.next >= 4 ||
+        ring.prev == comm->rank || ring.next == comm->rank ||
+        peers[ring.prev] == nullptr || peers[ring.next] == nullptr) return false;
+    const auto& send = peers[ring.next]->send[0];
+    const auto& recv = peers[ring.prev]->recv[0];
+    if (!send.connected || !recv.connected || send.transportComm != &shmTransport.send ||
+        recv.transportComm != &shmTransport.recv || send.proxyConn.proxyProgress != nullptr ||
+        recv.proxyConn.proxyProgress != nullptr || send.conn.connFifo != nullptr ||
+        recv.conn.connFifo != nullptr) return false;
+  }
+  return true;
+}
+
+/**
+ * @brief Admit the complete original clique only after all initializers join.
+ * @param comms Actual original ncclCommInitAll output array, fully initialized.
+ * @param count Original initialized participant count, exactly four here.
+ * @param nativeSelectorsAbsent Existing process selector presence sampled at init.
+ * @return Unanimous native scope, validated before any owner changes policy.
+ *
+ * The outermost successful blocking GroupEnd in ncclCommInitAll joins every
+ * async initialization job. This supplies a host happens-before relationship
+ * for topology, connected endpoints and external tuner state. Nested/grouped,
+ * nonblocking and separate InitRank entrypoints do not publish this policy.
+ * Native bootstrap already authenticated the same-process peerInfo owner map;
+ * require every completed owner to name this exact same output array.
+ */
+static inline bool llaminarSmallAllGatherCliqueScope(ncclComm_t const* comms, int count, bool nativeSelectorsAbsent) {
+  if (comms == nullptr || count != 4 || !nativeSelectorsAbsent || comms[0] == nullptr ||
+      comms[0]->peerInfo == nullptr) return false;
+  const auto& first = comms[0]->peerInfo[0];
+  for (int rank = 0; rank < 4; ++rank) {
+    const ncclComm* owner = comms[rank];
+    if (!llaminarSmallAllGatherScope(owner, nativeSelectorsAbsent) || owner->rank != rank ||
+        owner->commHash != comms[0]->commHash || owner->peerInfo == nullptr) return false;
+    for (int member = 0; member < 4; ++member) {
+      const auto& peer = owner->peerInfo[member];
+      if (peer.rank != member || peer.comm != comms[member] ||
+          peer.hostHash != first.hostHash || peer.pidHash != first.pidHash) return false;
+    }
+  }
+  return true;
+}
+
+/**
+ * @brief Publish one completed-clique decision without touching partial outputs.
+ * @param comms Original InitAll output array, inspected only after owned completion.
+ * @param count Original participant count.
+ * @param ownsCompleteInit Whether the original outermost GroupEnd completed here.
+ * @param nativeSelectorsAbsent Existing selector presence, sampled only at setup.
+ * @return True only when all four owners were admitted and published together.
+ *
+ * Nonadmission preserves every flag and inspects no incomplete communicator.
+ * All checks precede the first write; publication cannot partly fail. The
+ * caller owns original initialization/joining and invokes no extra lifecycle.
+ */
+static inline bool llaminarPublishSmallAllGatherPolicy(ncclComm_t* comms, int count,
+    bool ownsCompleteInit, bool nativeSelectorsAbsent) {
+  if (!ownsCompleteInit || count != 4 || !nativeSelectorsAbsent) return false;
+  if (!llaminarSmallAllGatherCliqueScope(comms, count, nativeSelectorsAbsent)) return false;
+  for (int rank = 0; rank < count; ++rank) comms[rank]->llaminarSmallAllGatherLL = true;
+  return true;
+}
+
+#endif
