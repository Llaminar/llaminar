+/**
+ * @brief Enqueue a captured, node-local byte allgather with device-owned rows.
+ * @param sendbuff Local input bank with capacityRows * rowBytes bytes.
+ * @param recvbuff Rank-major output using that same immutable capacity stride.
+ * @param liveRows Producer-owned INT32 scalar, ordered before the collective.
+ * @param capacityRows Positive immutable row capacity, bounded to INT32_MAX.
+ * @param rowBytes Exact useful bytes in one row.
+ * @param outgoingPayloadBytes Optional passive primitive-payload receipt.
+ * @param comm Existing native communicator; equal-prefix banks require one node.
+ * @param stream Exact non-default stream that orders producer and consumer.
+ * @return Native result; unsupported selected algorithms fail during planning.
+ *
+ * Native setup retains its algorithm and transport selection without a host
+ * bounce. Unsupported selected algorithms fail explicitly during planning.
+ */
+extern "C" __attribute__((visibility("default"))) ncclResult_t
+llaminarNcclAllGatherDeviceRows(const void* sendbuff, void* recvbuff,
+    const int32_t* liveRows, size_t capacityRows, size_t rowBytes,
+    unsigned long long* outgoingPayloadBytes, ncclComm_t comm, cudaStream_t stream) {
+  if (!sendbuff || !recvbuff || !liveRows || !stream || !comm ||
+      !capacityRows || capacityRows > INT32_MAX || !rowBytes ||
+      rowBytes > UINT32_MAX || rowBytes > SIZE_MAX / capacityRows) return ncclInvalidArgument;
+  int ranks;
+  NCCLCHECK(ncclCommCount(comm, &ranks));
+  if (ranks < 2 || comm->nNodes != 1) return ncclInvalidUsage;
+  ncclInfo info = {ncclFuncAllGather, "AllGatherDeviceRows", sendbuff,
+    recvbuff, capacityRows * rowBytes, ncclInt8, ncclSum, 0, comm, stream,
+    ALLGATHER_CHUNKSTEPS, ALLGATHER_SLICESTEPS};
+  info.llaminarRows = {liveRows, {uint32_t(rowBytes), uint32_t(capacityRows)}, outgoingPayloadBytes};
+  return ncclEnqueueCheck(&info);
+}
+
+/**
+ * @brief Enqueue a capacity-stable row-counted native reduction.
+ * @param func AllReduce or ReduceScatter; the latter has rank-major input banks.
+ * @param sendbuff Input allocation, including immutable captured bank strides.
+ * @param recvbuff Output allocation; its inactive tail must remain untouched.
+ * @param liveRows Ordered producer-owned INT32 row authority on this device.
+ * @param capacityRows Positive admitted number of rows in each bank.
+ * @param elementsPerRow Exact logical elements, independent of allocation slack.
+ * @param datatype Native wire scalar type, not the model weight format.
+ * @param op Native reduction operator; its arithmetic order is unchanged.
+ * @param outgoingPayloadBytes Optional passive counter of real primitive sends.
+ * @param comm Existing native node-local communicator.
+ * @param stream Exact non-default native collective stream.
+ * @return Enqueue result, with unsupported selected algorithms rejected.
+ */
+static ncclResult_t llaminarEnqueueReduction(ncclFunc_t func,
+    const void* sendbuff, void* recvbuff, const int32_t* liveRows,
+    size_t capacityRows, size_t elementsPerRow, ncclDataType_t datatype,
+    ncclRedOp_t op, unsigned long long* outgoingPayloadBytes,
+    ncclComm_t comm, cudaStream_t stream) {
+  if (!sendbuff || !recvbuff || !liveRows || !stream || !comm ||
+      !capacityRows || capacityRows > INT32_MAX || !elementsPerRow)
+    return ncclInvalidArgument;
+  // Match the engine's supported wire scalars without conflating them with the
+  // independent quantized weight codebook. Native operator checks still apply.
+  if (datatype != ncclInt8 && datatype != ncclInt32 && datatype != ncclFloat16 &&
+      datatype != ncclBfloat16 && datatype != ncclFloat32) return ncclInvalidArgument;
+  const size_t typeBytes = ncclTypeSize(datatype);
+  if (elementsPerRow > UINT32_MAX / typeBytes ||
+      capacityRows > SIZE_MAX / (elementsPerRow * typeBytes)) return ncclInvalidArgument;
+  int ranks;
+  NCCLCHECK(ncclCommCount(comm, &ranks));
+  if (ranks < 2 || comm->nNodes != 1) return ncclInvalidUsage;
+  const bool scatter = func == ncclFuncReduceScatter;
+  ncclInfo info = {func, scatter ? "ReduceScatterDeviceRows" : "AllReduceDeviceRows",
+    sendbuff, recvbuff, capacityRows * elementsPerRow, datatype, op, 0, comm, stream,
+    scatter ? REDUCESCATTER_CHUNKSTEPS : ALLREDUCE_CHUNKSTEPS,
+    scatter ? REDUCESCATTER_SLICESTEPS : ALLREDUCE_SLICESTEPS};
+  info.llaminarRows = {liveRows, {uint32_t(elementsPerRow * typeBytes), uint32_t(capacityRows)}, outgoingPayloadBytes};
+  return ncclEnqueueCheck(&info);
+}
+
+/** @brief Captured allreduce over the device-owned useful prefix; see the common enqueue contract. */
+extern "C" __attribute__((visibility("default"))) ncclResult_t
+llaminarNcclAllReduceDeviceRows(const void* sendbuff, void* recvbuff,
+    const int32_t* liveRows, size_t capacityRows, size_t elementsPerRow,
+    ncclDataType_t datatype, ncclRedOp_t op, unsigned long long* outgoingPayloadBytes,
+    ncclComm_t comm, cudaStream_t stream) {
+  return llaminarEnqueueReduction(ncclFuncAllReduce, sendbuff, recvbuff, liveRows,
+      capacityRows, elementsPerRow, datatype, op, outgoingPayloadBytes, comm, stream);
+}
+
+/** @brief Captured reduce-scatter with unchanged input bank strides; see the common enqueue contract. */
+extern "C" __attribute__((visibility("default"))) ncclResult_t
+llaminarNcclReduceScatterDeviceRows(const void* sendbuff, void* recvbuff,
+    const int32_t* liveRows, size_t capacityRows, size_t elementsPerRow,
+    ncclDataType_t datatype, ncclRedOp_t op, unsigned long long* outgoingPayloadBytes,
+    ncclComm_t comm, cudaStream_t stream) {
+  return llaminarEnqueueReduction(ncclFuncReduceScatter, sendbuff, recvbuff, liveRows,
+      capacityRows, elementsPerRow, datatype, op, outgoingPayloadBytes, comm, stream);
+}
