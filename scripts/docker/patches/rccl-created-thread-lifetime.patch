+/**
+ * @brief Abort outstanding native setup and join every actually created worker.
+ * @param jobs Actual intrusive queue retaining every job and communicator owner.
+ * @pre The creator/joiner retains all queued metadata until this function returns.
+ * @post Every previously Created receipt is Joined; Uncreated/Joined receipts are unchanged.
+ * Existing native parent/child abort flags are published before the first join.
+ * A worker may not have entered, or may have finished before create returned;
+ * neither observation replaces the actual created-thread receipt.
+ * @warning A failed join or existing JoinFailed receipt is immediately fatal.
+ * No caller may ignore this boundary and proceed with communicator cleanup, and
+ * no retry can transform an unproven join into permission to release owners.
+ */
+static void
+ncclLlaminarAbortAndJoinCreatedJobs(ncclIntruQueue<ncclAsyncJob, &ncclAsyncJob::next> *jobs) {
+  bool hasCreated = false;
+  for (auto *job = ncclIntruQueueHead(jobs); job; job = job->next) {
+    const auto state = ncclLlaminarLoadThreadOwnership(job);
+    hasCreated |= state == ncclNativeThreadOwnership::Created;
+    if (state == ncclNativeThreadOwnership::JoinFailed) {
+      WARN("Native setup already has a failed join; all owners must remain live job %p", job);
+      std::abort();
+    }
+  }
+  if (!hasCreated)
+    return;
+  for (auto *job = ncclIntruQueueHead(jobs); job; job = job->next) {
+    if (!job->destroyFlag) {
+      __atomic_store_n(job->abortFlag, 1, __ATOMIC_RELEASE);
+      __atomic_store_n(job->abortFlagDev, 1, __ATOMIC_RELEASE);
+      if (job->childAbortFlag) {
+        __atomic_store_n(job->childAbortFlag, 1, __ATOMIC_RELEASE);
+        __atomic_store_n(job->childAbortFlagDev, 1, __ATOMIC_RELEASE);
+      }
+    }
+  }
+  for (auto *job = ncclIntruQueueHead(jobs); job; job = job->next) {
+    if (ncclLlaminarLoadThreadOwnership(job) != ncclNativeThreadOwnership::Created)
+      continue;
+    const int error = pthread_join(job->thread, nullptr);
+    if (error != 0) {
+      ncclLlaminarStoreThreadOwnership(job, ncclNativeThreadOwnership::JoinFailed);
+      WARN("Failed native setup join; job and communicator owners cannot retire: %s",
+           strerror(error));
+      std::abort();
+    }
+    ncclLlaminarStoreThreadOwnership(job, ncclNativeThreadOwnership::Joined);
+    job->state = ncclGroupJobJoined;
+  }
+}
