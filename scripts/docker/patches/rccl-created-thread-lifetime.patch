+/**
+ * @brief Retire existing job metadata only after its created native thread joined.
+ * @param job Actual native async job; no borrowed or copied receipt is accepted.
+ * Created or join-failed owners remain reachable and fail before destruction.
+ */
+void ncclLlaminarDestroyAsyncJob(ncclAsyncJob *job) {
+  const auto state = ncclLlaminarLoadThreadOwnership(job);
+  if (state == ncclNativeThreadOwnership::Created ||
+      state == ncclNativeThreadOwnership::JoinFailed) {
+    WARN("Native job retirement requires successful join of its created thread job %p", job);
+    std::abort();
+  }
+  if (job->destructor)
+    job->destructor(job);
+}
