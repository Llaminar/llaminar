+/** @brief Creator/joiner-owned native handle; worker entry never writes this state. */
+enum class ncclNativeThreadOwnership : uint8_t { Uncreated, Created, Joined, JoinFailed };
+
 struct ncclAsyncJob {
   struct ncclAsyncJob* next;
   pthread_t thread;
@@ -44,7 +53,27 @@
   uint32_t* childAbortFlagDev; /* point to child abortFlagDev */
   ncclComm_t comm;
