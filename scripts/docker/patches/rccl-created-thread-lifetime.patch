+
+/**
+ * @brief Observe the creator/joiner receipt with the same enum on GCC and HIP Clang.
+ * @param job Actual native async job whose handle remains creator/joiner owned.
+ * @return Acquire observation; the worker never publishes this receipt.
+ */
+inline ncclNativeThreadOwnership ncclLlaminarLoadThreadOwnership(const ncclAsyncJob *job) {
+  ncclNativeThreadOwnership result;
+  __atomic_load(&job->nativeThreadOwnership, &result, __ATOMIC_ACQUIRE);
+  return result;
+}
+/**
+ * @brief Publish actual create/join ownership without an underlying-byte cast.
+ * @param job Actual native job, still retained by its creator/joiner.
+ * @param value Receipt matching an actual successful create/join or failed join.
+ */
+inline void ncclLlaminarStoreThreadOwnership(ncclAsyncJob *job, ncclNativeThreadOwnership value) {
+  __atomic_store(&job->nativeThreadOwnership, &value, __ATOMIC_RELEASE);
+}
 
