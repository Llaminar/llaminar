+  /**
+   * @brief Borrow the original producer without extending its native lifetime.
+   * Copy the identity under the event lock, then release it before entering
+   * the device registry. This keeps stream capture cleanup's stream -> event
+   * ordering independent of the registry -> stream inspection ordering.
+   */
+  Device::StreamLease BorrowCaptureStream() {
+    hipStream_t stream;
+    uint64_t identity;
+    int device;
+    {
+      std::scoped_lock lock(lock_);
+      stream = captureStream_;
+      identity = captureStreamId_;
+      device = captureDeviceId_;
+    }
+    if (stream == nullptr || stream == hipStreamLegacy) return {};
+    return g_devices[device]->BorrowStream(reinterpret_cast<Stream*>(stream), identity);
+  }
+  /** @brief Publish identity while record/capture still owns a live stream. */
+  void SetCaptureStream(hipStream_t stream) {
+    std::scoped_lock lock(lock_);
+    captureStream_ = stream;
+    const auto* producer = reinterpret_cast<Stream*>(stream);
+    const bool explicit_stream = stream != nullptr && stream != hipStreamLegacy;
+    captureStreamId_ = explicit_stream ? producer->GetStreamId() : 0;
+    captureDeviceId_ = explicit_stream ? producer->DeviceId() : -1;
+  }
   /// Returns previous captured nodes before event record
   const std::vector<hip::GraphNode*>& GetNodesPrevToRecorded() const {
     return nodesPrevToRecorded_;
