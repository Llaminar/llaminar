@@ -0,0 +1,108 @@
+/**
+ * @file llaminar_device_payload.h
+ * @brief Device-only live-payload clipping without changing native progress.
+ *
+ * The native algorithm owns capacity partitioning, peer ordering, chunk strides
+ * and acknowledgement counts. These helpers only narrow the elements handed
+ * to an already-required primitive. Empty chunks still execute that primitive.
+ */
+#ifndef LLAMINAR_NATIVE_DEVICE_PAYLOAD_H_
+#define LLAMINAR_NATIVE_DEVICE_PAYLOAD_H_
+
+/** @brief Work-uniform payload policy, selected before entering native loops. */
+enum class ncclLlaminarPayloadMode { Capacity, LivePrefix };
+
+/**
+ * @brief Select an unclipped specialization only when every byte is live.
+ * @param work Resolved shared work, already published by the native barrier.
+ * @return Capacity for ordinary or full unobserved work; LivePrefix otherwise.
+ *
+ * An observer deliberately retains the counted path, including for full work.
+ * The decision is uniform across the primitive group and immutable throughout
+ * the work item. It does not change acknowledgement counts or buffer strides.
+ */
+__device__ __forceinline__ ncclLlaminarPayloadMode ncclLlaminarSelectPayloadMode(
+    const ncclDevWorkColl* work) {
+  const volatile ncclLlaminarResolvedRows& extent = work->llaminarResolvedRows;
+  if (extent.liveBytes == ~size_t(0)) return ncclLlaminarPayloadMode::Capacity;
+  if (!extent.outgoingPayloadBytes && extent.liveBytes ==
+      size_t(extent.geometry.bytesPerRow) * extent.geometry.capacityRows)
+    return ncclLlaminarPayloadMode::Capacity;
+  return ncclLlaminarPayloadMode::LivePrefix;
+}
+
+/**
+ * @brief Resolve the captured pointer word before its shared work-pack store.
+ * @param pointerWord Borrowed device pointer, or zero for ordinary native work.
+ * @param geometryWord The adjacent admitted row-width/capacity pair.
+ * @return Validated useful byte end, or an unbounded end for ordinary work.
+ *
+ * The native loader's pack owner alone performs this transition. The existing
+ * work-publication barrier exposes resolved metadata to all primitive threads;
+ * no additional barrier, work bank, graph node or dispatch helper is needed.
+ * Host admission validates element divisibility and bounded row geometry.
+ */
+__device__ __forceinline__ uint64_t ncclLlaminarResolveRowWord(
+    uint64_t pointerWord, uint64_t geometryWord) {
+  if (!pointerWord) return ~uint64_t(0);
+  const int32_t rows = *reinterpret_cast<const int32_t*>(pointerWord);
+  const uint32_t bytesPerRow = uint32_t(geometryWord);
+  const uint32_t capacityRows = uint32_t(geometryWord >> 32);
+  if (rows < 0 || !bytesPerRow || !capacityRows ||
+      uint32_t(rows) > capacityRows) {
+#if defined(__HIP_DEVICE_COMPILE__)
+    __builtin_trap();
+#else
+    asm volatile("trap;");
+#endif
+  }
+  // Widen before multiplication. Empty and ordinary work remain distinct.
+  return uint64_t(uint32_t(rows)) * bytesPerRow;
+}
+
+/**
+ * @brief Return the exact primitive count and optionally observe its sends.
+ * @param work Prepared shared descriptor; its observer never drives progress.
+ * @param tid Thread within the native primitive group, not necessarily the CTA.
+ * @param offset Element offset within that bank, not the allocation base.
+ * @param elements Original native chunk count, which may be nonpositive.
+ * @param sends Number of actual outgoing peers for this primitive invocation.
+ * @return Count passed unchanged to the following native primitive.
+ *
+ * Callers must retain the original loop/step schedule. Receipts accumulate the
+ * same count the primitive consumes, not an independently predicted byte count.
+ */
+template<typename T,
+    ncclLlaminarPayloadMode Mode = ncclLlaminarPayloadMode::LivePrefix,
+    typename Offset>
+__device__ __forceinline__ int ncclLlaminarPayload(
+    const ncclDevWorkColl* work, int tid, Offset offset,
+    int elements, int sends) {
+  // Compile this entire helper out of the full-span specialization. Keeping
+  // the choice outside the native loop avoids per-chunk metadata reloads and
+  // prevents live-prefix state extending register lifetimes in the copy loop.
+  if constexpr (Mode == ncclLlaminarPayloadMode::Capacity) return elements;
+  // Reload immutable shared metadata at the use site. Volatile prevents the
+  // compiler retaining an extra 64-bit end across a large native primitive.
+  const volatile ncclLlaminarResolvedRows& extent = work->llaminarResolvedRows;
+  const size_t endBytes = extent.liveBytes;
+  if (endBytes == ~size_t(0)) return elements;
+  const size_t end = endBytes / sizeof(T);
+  const size_t begin = size_t(offset);
+  const int count = elements <= 0 || begin >= end ? 0 :
+      int(min(size_t(elements), end - begin));
+  if (tid == 0 && sends != 0 && extent.outgoingPayloadBytes)
+    atomicAdd(extent.outgoingPayloadBytes,
+        static_cast<unsigned long long>(count) * sizeof(T) * sends);
+  return count;
+}
+
+/** @brief Count real child links; unused tree entries are protocol metadata. */
+template<int N>
+__device__ __forceinline__ int ncclLlaminarTreeFan(const int (&children)[N]) {
+  int count = 0;
+  #pragma unroll
+  for (int i = 0; i < N; ++i) count += children[i] != -1;
+  return count;
+}
+#endif
