+/**
+ * @brief Publish the proven entry and geometry atomically at the plan boundary.
+ * @param plan Native plan receiving its immutable captured launch identity.
+ * @param seal Result from the complete actual-input validator.
+ * @param kernel Exact generated entry selected for the original unroll/trace policy.
+ * @return InvalidUsage before mutation for foreign required work or absent entry.
+ * Ordinary unsealed native work retains its original kernel and geometry.
+ */
+inline ncclResult_t ncclLlaminarBindP2pLaunch(ncclKernelPlan* plan, ncclP2pLaunchSeal seal, void* kernel) {
+  if (seal.status!=ncclP2pLaunchStatus::Sealed)
+    return seal.requirement==ncclP2pLaunchRequirement::DeviceCounted ? ncclInvalidUsage : ncclSuccess;
+  if (!kernel) return ncclInvalidUsage;
+  plan->kernelFn=kernel;
+  plan->kernelSpecialized=true;
+  plan->threadPerBlock=NCCL_LLAMINAR_LOCAL_P2P_NTHREADS;
+  return ncclSuccess;
+}
+/**
+ * @brief Drain all unpublished owners if a later plan rejects before publication.
+ * @param planner Actual native queue containing earlier unpublished plans.
+ * @param rejected Complete current plan, not yet enqueued.
+ * @param retire Typed pending-phase retirement supplied by the native owner.
+ * @return First cleanup error after every owner has been visited exactly once.
+ *
+ * Native group cleanup assumes persistent queued plans already have graph
+ * references. At this earlier boundary no plan has acquired those references.
+ */
+template<class RetirePending>
+inline ncclResult_t ncclLlaminarRetirePendingP2pPlanSet(ncclKernelPlanner* planner,
+    ncclKernelPlan* rejected, RetirePending retire) {
+  ncclResult_t result=retire(rejected);
+  while (!ncclIntruQueueEmpty(&planner->planQueue)) {
+    auto* earlier=ncclIntruQueueDequeue(&planner->planQueue);
+    const auto status=retire(earlier);
+    if (result==ncclSuccess) result=status;
+  }
+  planner->unlaunchedPlansHead=nullptr;
+  return result;
+}
