+/**
+ * @file llaminar_p2p_launch.h
+ * @brief Seal actual native P2P batches, source work and selected connections.
+ *
+ * This transient planner proof owns no allocation or progress ledger. The
+ * serialized batches and native connector remain the sole work/transport
+ * authorities. Counted payloads require this direct entry; ordinary foreign
+ * native work retains its existing kernel and transport semantics.
+ */
+#ifndef NCCL_LLAMINAR_P2P_LAUNCH_H_
+#define NCCL_LLAMINAR_P2P_LAUNCH_H_
+#include "comm.h"
+#include "transport.h"
+#include <vector>
+
+/** @brief Whether the public API requires device-owned counted progress. */
+enum class ncclP2pLaunchRequirement { OrdinaryNative, DeviceCounted };
+/** @brief Complete outcome of validating the direct entry's physical inputs. */
+enum class ncclP2pLaunchStatus { Sealed, Empty, ForeignWork, Geometry, Connection };
+/** @brief Immutable publication result; invalid required work cannot launch. */
+struct ncclP2pLaunchSeal {
+  ncclP2pLaunchRequirement requirement;
+  ncclP2pLaunchStatus status;
+};
+
+/**
+ * @brief Resolve a serialized work offset against the actual retained source list.
+ * @param plan Native plan whose source list owns every published work byte.
+ * @param wanted Exact byte offset from the serialized batch.
+ * @return Exact P2P descriptor or null for interior, missing or foreign storage.
+ */
+inline ncclDevWorkP2p const* ncclLlaminarP2pWorkAt(ncclKernelPlan const* plan, size_t wanted) {
+  size_t offset = 0;
+  for (auto* node = plan->workQueue.head; node; node = node->next) {
+    if (node->size < 0 || offset > plan->workBytes || size_t(node->size) > plan->workBytes-offset) return nullptr;
+    if (offset == wanted)
+      return node->workType == ncclDevWorkTypeP2p && node->size == sizeof(ncclDevWorkP2p)
+          ? reinterpret_cast<ncclDevWorkP2p const*>(node+1) : nullptr;
+    offset += size_t(node->size);
+    if (offset > wanted) return nullptr;
+  }
+  return nullptr;
+}
+
+/**
+ * @brief Validate the active direction's actual connected device-progress transport.
+ * @param comm Fully connected native communicator.
+ * @param channel Actual channel selected by the serialized batch chain.
+ * @param peer Native work's actual peer rank.
+ * @param send Whether this is the send connector.
+ * @param connection Actual selected index from the original serialized work.
+ * @return True only for selected local P2P/SHM without proxy/CE/network progress.
+ */
+inline bool ncclLlaminarP2pConnection(ncclComm const* comm, int channel, int peer, bool send, int connection) {
+  if (connection < 0 || connection >= NCCL_MAX_CONNS || peer < 0 || peer >= comm->nRanks || channel < 0 || channel >= MAXCHANNELS ||
+      !comm->channels[channel].peers || !comm->channels[channel].peers[peer]) return false;
+  auto const* endpoint = comm->channels[channel].peers[peer];
+  auto const* conn = send ? &endpoint->send[connection] : &endpoint->recv[connection];
+  auto const* p2p = send ? &p2pTransport.send : &p2pTransport.recv;
+  auto const* shm = send ? &shmTransport.send : &shmTransport.recv;
+  return conn->connected && (conn->transportComm == p2p || conn->transportComm == shm) &&
+      !conn->proxyConn.proxyProgress &&
+      !(conn->conn.flags & NCCL_DIRECT_NIC) && !conn->conn.netDeviceHandle.handle &&
+      conn->conn.netDeviceHandle.netDeviceType==NCCL_NET_DEVICE_HOST;
+}
+
+/**
+ * @brief Prove every channel chain, work reference and active connection before launch.
+ * @param comm Native communicator supplying actual physical-host and connector facts.
+ * @param plan Complete native source work/task inventory, before publication.
+ * @param batches Actual final channel-interleaved serialized batch array.
+ * @param count Exact array length.
+ * @return A typed seal; required DeviceCounted work fails if it is not Sealed.
+ *
+ * The actual communicator wave width determines its bounded work population:
+ * 256 threads support two works with64-lane waves and four with32-lane waves.
+ * Extension batches are rejected because their fused count is not independent.
+ * All references resolve to actual source-list boundaries and every batch is
+ * visited exactly once through the same per-channel links the device replays.
+ */
+inline ncclP2pLaunchSeal ncclLlaminarSealP2pLaunch(ncclComm const* comm,
+    ncclKernelPlan const* plan, ncclDevWorkBatch const* batches, int count) {
+  ncclP2pLaunchRequirement requirement = ncclP2pLaunchRequirement::OrdinaryNative;
+  for (auto* task = plan->p2pTaskQueue.head; task; task = task->next) {
+    const auto& payload=task->llaminarTransfer.payload;
+    // Completion kind is required even for a malformed absent binding: it must
+    // never silently select the ordinary indirect entry without its receipt.
+    if (payload.active() || payload.kind==ncclLlaminarPayloadKind::CompletedBytes ||
+        payload.kind==ncclLlaminarPayloadKind::CompletedSourceSlice)
+      requirement=ncclP2pLaunchRequirement::DeviceCounted;
