+/**
+ * @brief Broadcast one original UINT64 prefix through native library-selected transports.
+ * @param sendbuff Root payload bank; no receiver contribution is required.
+ * @param recvbuff Original per-participant destination; root in-place is legal.
+ * @param liveBytes Root-authored device communication metadata; receivers acquire into this existing field.
+ * @param capacityBytes Positive retained bound, never useful wire bytes.
+ * @param root Original communicator coordinate, not a device ordinal.
+ * @param completion Original device frame, sticky first-error and required receive receipt.
+ * @param comm Original initialized node-local communicator, retained through native retirement.
+ * @param stream Exact explicit stream after the root's original extent producer.
+ * @return Native enqueue status, without transport fallback or a host count read.
+ * Header and payload close distinct depth0 native plans, preventing receiver
+ * count prefetch in a fused header/payload work pack. Aborted communicators are
+ * not reset/rearmed by this API. Device source-relative slices are unsupported.
+ */
+extern "C" __attribute__((visibility("default"))) ncclResult_t
+llaminarNcclBroadcastCompletedBytes(const void* sendbuff, void* recvbuff,
+    uint64_t* liveBytes, size_t capacityBytes, int root,
+    const ncclLlaminarCompletionOperand* completion, ncclComm_t comm, hipStream_t stream) {
+  if (!sendbuff || !recvbuff || !liveBytes || !completion || !comm ||
+      reinterpret_cast<uintptr_t>(stream) <= 2 || !capacityBytes || capacityBytes > PTRDIFF_MAX ||
+      reinterpret_cast<uintptr_t>(liveBytes) % alignof(uint64_t) ||
+      (completion && reinterpret_cast<uintptr_t>(completion) % alignof(ncclLlaminarCompletionOperand)))
+    return ncclInvalidArgument;
+  if (ncclGroupDepth != 0) {
+    WARN("Device-byte broadcast requires separate native extent/payload plans; an outer group is invalid");
+    return ncclInvalidUsage;
+  }
+  int ranks;
+  NCCLCHECK(ncclCommCount(comm, &ranks));
+  if (ranks < 2 || comm->nNodes != 1 || root < 0 || root >= ranks) return ncclInvalidUsage;
+  const uintptr_t a = reinterpret_cast<uintptr_t>(sendbuff);
+  const uintptr_t b = reinterpret_cast<uintptr_t>(recvbuff);
+  const uintptr_t c = reinterpret_cast<uintptr_t>(liveBytes);
+  const uintptr_t q = reinterpret_cast<uintptr_t>(completion);
+  const auto overlap = [](uintptr_t x, size_t xn, uintptr_t y, size_t yn) {
+    return x < y + yn && y < x + xn;
+  };
+  if (a > UINTPTR_MAX - capacityBytes || b > UINTPTR_MAX - capacityBytes ||
+      c > UINTPTR_MAX - sizeof(uint64_t) || (q && q > UINTPTR_MAX - sizeof(ncclLlaminarCompletionOperand)))
+    return ncclInvalidArgument;
+  if ((comm->rank == root && a != b && overlap(a, capacityBytes, b, capacityBytes)) ||
+      overlap(c, sizeof(uint64_t), b, capacityBytes) ||
+      (comm->rank == root && overlap(c, sizeof(uint64_t), a, capacityBytes)) ||
+      (q && (overlap(q, sizeof(ncclLlaminarCompletionOperand), c, sizeof(uint64_t)) ||
+          overlap(q, sizeof(ncclLlaminarCompletionOperand), b, capacityBytes) ||
+          (comm->rank == root && overlap(q, sizeof(ncclLlaminarCompletionOperand), a, capacityBytes)))))
+    return ncclInvalidArgument;
+  // Never read the device word here. Ordinary native broadcast leaves the
+  // root's in-place extent unchanged and publishes it to each actual receiver.
+  NCCLCHECK(ncclBroadcast(liveBytes, liveBytes, sizeof(uint64_t), ncclInt8, root, comm, stream));
+  ncclInfo info = {ncclFuncBroadcast, "BroadcastCompletedBytes", sendbuff,
+    recvbuff, capacityBytes, ncclInt8, ncclSum, root, comm, stream,
+    BROADCAST_CHUNKSTEPS, BROADCAST_SLICESTEPS};
+  info.llaminarPayload.binding.bytes = {liveBytes, uint64_t(capacityBytes), completion};
+  info.llaminarPayload.kind = ncclLlaminarPayloadKind::CompletedBytes;
+  return ncclEnqueueCheck(&info);
+}
