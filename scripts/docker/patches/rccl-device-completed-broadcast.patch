+/** @file llaminar_device_completion.h
+ * @brief Native original-stream receive evidence after every counted primitive.
+ * Included after native shared/primitive declarations; this is no separate kernel.
+ */
+#ifndef LLAMINAR_NATIVE_DEVICE_COMPLETION_H_
+#define LLAMINAR_NATIVE_DEVICE_COMPLETION_H_
+
+/** @brief Authenticate required device metadata before entering any native payload primitive.
+ * @param work Original shared native work and immutable metadata binding.
+ * @param tid Native work-group thread index; only its original writer publishes.
+ */
+__device__ __forceinline__ void ncclLlaminarBeginCompletionOperand(const volatile ncclLlaminarCompletionOperand* original, int tid, bool primary) {
+  if (!original || original->reserved || !original->table || !original->admission ||
+      !original->sequence || !original->message || !original->firstError || !original->receipt || original->failureCode <= 0 ||
+      reinterpret_cast<uintptr_t>(original->table) % alignof(uint64_t) ||
+      reinterpret_cast<uintptr_t>(original->admission) % alignof(uint64_t) ||
+      reinterpret_cast<uintptr_t>(original->sequence) % alignof(uint64_t) ||
+      reinterpret_cast<uintptr_t>(original->firstError) % alignof(int32_t) ||
+      reinterpret_cast<uintptr_t>(original->receipt) % alignof(ncclLlaminarByteCompletion) ||
+      (original->outgoingPayloadBytes && reinterpret_cast<uintptr_t>(original->outgoingPayloadBytes) % alignof(unsigned long long))) {
+#if defined(__HIP_DEVICE_COMPILE__)
+    __builtin_trap();
+#else
+    asm volatile("trap;");
+#endif
+  }
+  if (tid == 0) {
+    if (!*original->table || !*original->admission || !*original->sequence ||
+        ncclLlaminarAcquireAbort(ncclShmem.comm.abortFlag))
+      atomicCAS(original->firstError, 0, original->failureCode);
+    if (primary) {
+      auto* receipt = original->receipt;
+      // Only this original channel publishes a disposition. Every channel can
+      // veto it through the SAME sticky error after its own native primitives.
+      atomicExch(reinterpret_cast<unsigned int*>(&receipt->phase),
+          static_cast<unsigned int>(ncclLlaminarCompletionPhase::Pending));
+      receipt->table = *original->table;
+      receipt->admission = *original->admission;
+      receipt->sequence = *original->sequence;
+      receipt->bytes = 0;
+      receipt->nativeAbortFlag = ncclShmem.comm.abortFlag;
+      receipt->nativeCommunicator = ncclShmem.args.comm;
+      receipt->message = original->message;
+      receipt->reserved = 0;
+    }
+  }
+}
+/**
+ * @brief Publish actual native completion after the primitive destructor's original barrier.
+ * @param work Original shared native work, retained through the final primitive barrier.
+ * @param tid Native work-group thread index.
+ * @param liveBytes Actual resolved total useful extent, not a capacity or byte observer.
+ * Every channel performs abort/error publication, including zero useful bytes.
+ * ACK must be ordered after the WHOLE native launch, then check this original
+ * flag again for late cancellation and the original sticky first-error field.
+ */
+__device__ __forceinline__ void ncclLlaminarFinishCompletionOperand(
+    const volatile ncclLlaminarCompletionOperand* original, int tid, size_t liveBytes, bool primary) {
+  if (tid != 0) return;
+  if (ncclShmem.aborted || ncclLlaminarAcquireAbort(ncclShmem.comm.abortFlag))
+    atomicCAS(original->firstError, 0, original->failureCode);
+  if (primary) {
+    auto* receipt = original->receipt;
+    receipt->bytes = liveBytes;
+    __threadfence();
+    const auto phase = atomicAdd(original->firstError, 0) == 0
+        ? ncclLlaminarCompletionPhase::Completed : ncclLlaminarCompletionPhase::Aborted;
+    atomicExch(reinterpret_cast<unsigned int*>(&receipt->phase), static_cast<unsigned int>(phase));
+  }
+}
+
+
+/** @brief Authenticate the original collective operand before any native payload primitive.
+ * @param work Actual native collective work. @param tid Original primitive group index. */
+__device__ __forceinline__ void ncclLlaminarBeginCompletion(const ncclDevWorkColl* work,int tid) {
+  if(work->llaminarPayload.kind != ncclLlaminarPayloadKind::Rows)
+    ncclLlaminarBeginCompletionOperand(work->llaminarPayload.binding.completed.completion,tid,ncclShmem.channelId==work->channelLo);
+}
+/** @brief Publish after the actual collective primitive's destructor and original barrier.
+ * @param work Actual native work. @param tid Original primitive group index.
+ * @param liveBytes Exact useful bytes, never capacity. */
+__device__ __forceinline__ void ncclLlaminarFinishCompletion(const ncclDevWorkColl* work,int tid,size_t liveBytes) {
+  if(work->llaminarPayload.kind != ncclLlaminarPayloadKind::Rows)
+    ncclLlaminarFinishCompletionOperand(work->llaminarPayload.binding.completed.completion,tid,liveBytes,ncclShmem.channelId==work->channelLo);
+}
+
+#endif
