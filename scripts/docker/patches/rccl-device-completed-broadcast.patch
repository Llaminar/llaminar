+/**
+ * @brief Resolve the exact generated entry for the original immutable policy.
+ * @param comm Original initialized communicator, including actual unroll/trace.
+ * @return Its unique generated function or null for missing/ambiguous identity.
+ */
+inline void* ncclLlaminarLocalP2pKernelFor(ncclComm const* comm) {
+  bool trace=false;
+#ifdef ENABLE_COLLTRACE
+  trace=comm->collTraceEnabled;
+#endif
+  bool found=false;
+  void* kernel=nullptr;
+  for (int i=0;i<ncclLocalP2pKernelCount;++i) {
+    const auto& entry=ncclLocalP2pKernelList[i];
+    if (entry.unrollIndex==comm->unroll && entry.collTrace==trace) {
+      if (found) return nullptr;
+      found=true;kernel=entry.kernelFn;
+    }
+  }
+  return kernel;
