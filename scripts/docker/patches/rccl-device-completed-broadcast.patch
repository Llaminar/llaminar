+/**
+ * @file llaminar_device_p2p.h
+ * @brief Exact useful-byte clipping and completion in original addressed native P2P work.
+ * Original capacity-derived channels and transport remain authoritative. The
+ * separately sealed device-progress entry advances only live work, with one
+ * zero-byte operation for a selected empty channel. Native progress is unchanged.
+ */
+#ifndef LLAMINAR_NATIVE_DEVICE_P2P_H_
+#define LLAMINAR_NATIVE_DEVICE_P2P_H_
+#include "llaminar_device_payload.h"
+#include "llaminar_device_completion.h"
+/** @brief One immutable per-invocation view of original device-authored metadata. */
+struct ncclLlaminarP2pExtent {size_t liveBytes, localBytes, sourceOffset; bool primary;};
+/**
+ * @brief Resolve only the actual endpoint's borrowed count after its separate header plan.
+ * @param work Original shared peer work, whose native startup already partitioned capacity.
+ * @param sending The actual local producer/consumer half of this work.
+ * @return Exact global/local useful extent and producer-only original source offset.
+ */
+__device__ __forceinline__ ncclLlaminarP2pExtent ncclLlaminarResolveP2p(
+    const ncclDevWorkP2p* work,bool sending) {
+  const auto& transfer=sending?work->sendTransfer:work->recvTransfer;
+  const size_t localCapacity=sending?work->sendBytes:work->recvBytes;
+  const auto kind=transfer.payload.kind;
+  if(kind==ncclLlaminarPayloadKind::Rows && !transfer.payload.active())
+    return {localCapacity,localCapacity,0,false};
+  if(!transfer.payload.active() || !transfer.capacityBytes || (kind!=ncclLlaminarPayloadKind::CompletedBytes &&
+      kind!=ncclLlaminarPayloadKind::CompletedSourceSlice) ||
+      (kind==ncclLlaminarPayloadKind::CompletedSourceSlice && !sending)) {
+#if defined(__HIP_DEVICE_COMPILE__)
+    __builtin_trap();
+#else
+    asm volatile("trap;");
+#endif
+  }
+  size_t live=0,offset=0;
+  // Aborted header receives grant no validity to stale count/slice storage.
+  if(!ncclLlaminarAcquireAbort(ncclShmem.comm.abortFlag)) {
+    if(kind==ncclLlaminarPayloadKind::CompletedSourceSlice) {
+      const auto slice=ncclLlaminarResolveSourceSlice(transfer.payload.binding.slice,
+          transfer.capacityBytes,transfer.sourceOffsetOrigin);
+      live=slice.liveBytes;offset=slice.byteOffset;
+    }else live=ncclLlaminarResolvePayloadWord(
+        reinterpret_cast<uint64_t>(transfer.payload.binding.bytes.bytes),transfer.capacityBytes,
+        uint64_t(kind),ncclShmem.comm.abortFlag);
+  }
+  const int nParts=sending?work->nSendChannels:work->nRecvChannels;
+  const int part=ncclP2pChannelToPart(work->nP2pChannels,work->channelBase,ncclShmem.channelId,ncclShmem.comm.p2pnChannelsPerPeer,ncclShmem.comm.nNodes);
+  size_t first,last;ncclP2pPartBounds(nParts,part,transfer.capacityBytes,&first,&last);
+  const size_t local=first>=live?0:min(last-first,live-first);
+  // Empty capacity parts still perform the original protocol handoff, but
+  // their borrowed address stays inside the admitted original source bank.
+  // A zero-byte end descriptor is valid; adding that end offset after native
+  // capacity partitioning would otherwise form an out-of-bank pointer.
+  return {live,local,local?offset:0,part==0};
+}
+/** @brief Clip one required native step to useful bytes and count only its actual sends.
+ * @param work Original addressed work. @param sending Actual operation half.
+ * @param tid Original primitive thread. @param extent Exact local useful extent.
+ * @param cursor Original capacity step offset. @param count Original step width.
+ * @return Actual useful payload width; zero still executes required protocol progress. */
+__device__ __forceinline__ int ncclLlaminarP2pCount(const ncclDevWorkP2p* work,bool sending,
+    int tid,const ncclLlaminarP2pExtent& extent,size_t cursor,int count) {
+  const auto& transfer=sending?work->sendTransfer:work->recvTransfer;
+  if(!transfer.payload.active())return count;
+  const int useful=cursor>=extent.localBytes?0:int(min(size_t(count),extent.localBytes-cursor));
+  const auto* original=transfer.payload.binding.bytes.completion;
+  if(sending && tid==0 && original->outgoingPayloadBytes)
+    atomicAdd(original->outgoingPayloadBytes,static_cast<unsigned long long>(useful));
+  return useful;
+}
