+      ClPrint(amd::LOG_ERROR, amd::LOG_CODE,
+              "[hipGraph] Missing device kernel metadata for argument sizing on device %d", dev_id_);
+      return hipErrorInvalidDeviceFunction;
+    }
+    const size_t bytes = deviceKernel->KernargSegmentByteSize();
+    const size_t alignment = deviceKernel->KernargSegmentAlignment();
+    if (alignment == 0 || (alignment & (alignment - 1)) != 0 ||
+        bytes > std::numeric_limits<size_t>::max() - (alignment - 1)) {
+      ClPrint(amd::LOG_ERROR, amd::LOG_CODE,
+              "[hipGraph] Invalid kernel argument geometry: device %d bytes %zu alignment %zu",
