+  hipError_t ResolveKernelArgMetadata(const hipKernelNodeParams& params) {
+    if (dev_id_ < 0 || static_cast<size_t>(dev_id_) >= g_devices.size() ||
+        g_devices[dev_id_] == nullptr || g_devices[dev_id_]->devices().empty() ||
