+      ClPrint(amd::LOG_ERROR, amd::LOG_CODE,
+              "[hipGraph] Missing kernel function for argument sizing on device %d", dev_id_);
+      return hipErrorInvalidDeviceFunction;
+    }
+    const amd::Kernel* kernel = hip::asKernel(func);
+    const auto* device = g_devices[dev_id_]->devices()[0];
+    const device::Kernel* deviceKernel = kernel == nullptr ? nullptr : kernel->getDeviceKernel(*device);
