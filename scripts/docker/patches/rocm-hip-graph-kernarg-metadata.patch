+      return hipErrorInvalidDeviceFunction;
+    }
+    resolvedFunc_ = func;
+    kernargSegmentByteSize_ = bytes;
+    kernargSegmentAlignment_ = alignment;
+    alignedKernArgSize_ = amd::alignUp(bytes, alignment);
+    return hipSuccess;
+  }
