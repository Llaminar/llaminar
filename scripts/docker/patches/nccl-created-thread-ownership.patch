+    ncclIntruQueue<ncclAsyncJob, &ncclAsyncJob::next>* jobs) {
+  bool hasCreated = false;
+  for (auto* job = ncclIntruQueueHead(jobs); job; job = job->next) {
+    const auto state = ncclLlaminarLoadThreadOwnership(job);
+    hasCreated |= state == ncclNativeThreadOwnership::Created;
+    if (state == ncclNativeThreadOwnership::JoinFailed) {
+      WARN("Previously failed native join cannot be retried or release ownership");
+      std::abort();
+    }
+  }
