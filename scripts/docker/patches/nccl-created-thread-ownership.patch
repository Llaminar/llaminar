+/**
+ * @brief Successful native thread ownership, independent of worker entry observation.
+ * Only the creator and actual joiner write this field. Worker completion can
+ * precede pthread_create's return and must never overwrite a creator receipt.
+ */
+enum class ncclNativeThreadOwnership : uint8_t { Uncreated, Created, Joined, JoinFailed };
