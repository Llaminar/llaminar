+/**
+ * @brief Read the creator/joiner receipt with a compiler-portable typed atomic.
+ * @param job Actual live native job owner, retained independently of worker entry.
+ * @return Current creation/join obligation; no worker-completion state is inferred.
+ */
+inline ncclNativeThreadOwnership ncclLlaminarLoadThreadOwnership(const ncclAsyncJob* job) noexcept {
+  ncclNativeThreadOwnership value;
+  __atomic_load(&job->nativeThreadOwnership, &value, __ATOMIC_ACQUIRE);
+  return value;
+}
+/**
+ * @brief Publish actual successful creation/join or permanent join failure.
+ * @param job Actual source-owned job; workers never call this mutation boundary.
+ * @param value Creator/joiner transition established by the corresponding native API.
+ */
+inline void ncclLlaminarStoreThreadOwnership(ncclAsyncJob* job,
+                                            ncclNativeThreadOwnership value) noexcept {
+  __atomic_store(&job->nativeThreadOwnership, &value, __ATOMIC_RELEASE);
+}
 
