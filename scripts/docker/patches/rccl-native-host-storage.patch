+/**
+ * @file llaminar_host_transport.h
+ * @brief Fixed passive ABI for actual native transport descriptor ownership.
+ *
+ * These endpoint observations are not unique physical-byte accounting and may
+ * not be used for allocation or placement. Call only while setup/teardown is
+ * quiescent. No GPU state is read, no payload is copied and no event is waited.
+ */
+#ifndef LLAMINAR_RCCL_HOST_TRANSPORT_H_
+#define LLAMINAR_RCCL_HOST_TRANSPORT_H_
+
+#include <stdint.h>
+
+/** @brief Version-one C layout, shared with Llaminar's SDK-free loader. */
+struct llaminarRcclHostTransportStorageV1 {
+  uint64_t abi_version;
+  uint64_t record_bytes;
+  uint64_t same_process_pinned_connections;
+  uint64_t shared_process_registered_connections;
+  uint64_t cu_mem_connections;
+  uint64_t same_process_pinned_mapped_bytes;
+  uint64_t shared_process_registered_mapped_bytes;
+  uint64_t cu_mem_mapped_bytes;
+};
+static_assert(sizeof(llaminarRcclHostTransportStorageV1) == 64, "host storage ABI");
+
+#endif
