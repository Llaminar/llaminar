+/**
+ * @brief Allocate mapped portable host backing with one explicit native owner.
+ * @param size Exact native protocol storage extent.
+ * @param desc Published descriptor owns the creator reference on success.
+ * @param host Output host mapping; never a file alias.
+ * @param device Optional exact native mapped pointer for this endpoint.
+ * @return Native error; a failed allocation does not select file registration.
+ */
+static ncclResult_t shmAllocatePinned(size_t size, ncclShmIpcDesc_t* desc,
+    void** host, void** device) {
+  auto* owner = new (std::nothrow) ncclShmPinnedOwner;
+  if (!owner) return ncclSystemError;
+  owner->size = size;
+  ncclResult_t result = ncclSuccess;
+  unsigned flags = cudaHostAllocPortable | cudaHostAllocMapped;
+#if defined(HIP_HOST_UNCACHED_MEMORY)
+  flags |= hipHostMallocUncached;
+#endif
+  CUDACHECKGOTO(hipHostMalloc(&owner->host, size, flags), result, fail);
+  if (device) CUDACHECKGOTO(cudaHostGetDevicePointer(device, owner->host, 0), result, fail);
+  memset(owner->host, 0, size);
+  *host = owner->host;
+  desc->shmpi = {owner, size};
+  desc->kind = ncclShmStorageKind::SameProcessPinned;
+  INFO(NCCL_SHM, "NATIVE pinned same-process host buffer size %zu ptr %p", size, *host);
+  return ncclSuccess;
+fail:
+  if (owner->host) (void)cudaFreeHost(owner->host);
+  delete owner;
+  return result;
+}
