+/**
+ * @brief Sole allocation owner for same-process native SHM transport backing.
+ *
+ * The creator and imported endpoint descriptors each own one reference. The
+ * native allocation is driver-backed under Llaminar's early ROCr ABI, not a
+ * registered migratable POSIX mapping. No payload, protocol or GPU fence changes.
+ */
+struct ncclShmPinnedOwner {
+  std::atomic<unsigned> references{1};
+  void* host = nullptr;
+  size_t size = 0;
+  pid_t process = getpid();
