+      if (!endpoints) continue;
+      for (int index = 0; index < NCCL_MAX_CONNS; ++index) {
+        const ncclConnector* send = &endpoints->send[index];
+        const ncclConnector* recv = &endpoints->recv[index];
+        const ncclShmIpcDesc_t* descriptors[2] = {nullptr, nullptr};
+        if (send->connected && send->transportComm == &shmTransport.send)
+          descriptors[0] = &static_cast<shmSendResources*>(send->transportResources)->remDesc;
+        if (recv->connected && recv->transportComm == &shmTransport.recv)
+          descriptors[1] = &static_cast<shmRecvResources*>(recv->transportResources)->remDesc;
+        for (const auto* desc : descriptors) {
+          if (!desc) continue;
+          if (desc->kind == ncclShmStorageKind::SameProcessPinned) {
+            ++result.same_process_pinned_connections;
+            result.same_process_pinned_mapped_bytes += desc->shmpi.size;
+          } else if (desc->kind == ncclShmStorageKind::RegisteredFile) {
+            ++result.shared_process_registered_connections;
+            result.shared_process_registered_mapped_bytes += desc->shmli.shmSize;
+          } else if (desc->kind == ncclShmStorageKind::CuMem) {
+            ++result.cu_mem_connections;
+            result.cu_mem_mapped_bytes += desc->shmci.size;
+          } else {
+            return ncclInvalidUsage;
+          }
+        }
+      }
+    }
+  }
+  *output = result;
+  return ncclSuccess;
+}
