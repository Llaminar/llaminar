+/**
+ * @brief Borrow immutable device abort provenance from the original communicator.
+ * @param comm Original initialized communicator whose lifetime the caller retains.
+ * @param original Host output for immutable device identities only, never GPU values.
+ * @return Native status; absent original identities reject without side effects.
+ * No device value is read, allocation made or native operation issued here.
+ * The caller must strongly retain this same communicator through capture/ACK/retirement.
+ */
+extern "C" __attribute__((visibility("default"))) ncclResult_t
+llaminarNcclCompletionAuthority(ncclComm_t comm, ncclLlaminarCompletionAuthority* original) {
+  if (!comm || !original || !comm->abortFlagDev || !comm->devComm) return ncclInvalidArgument;
+  *original = {comm->abortFlagDev, comm->devComm};
+  return ncclSuccess;
+}
