+__global__ __launch_bounds__(64,1) void ncclDevKernel_P2pProgressObservation(
+    const ncclKernelComm* original,const volatile uint32_t* abortProvenance,int peer,
+    ncclLlaminarP2pProgress* output) {
+  if(threadIdx.x || blockIdx.x)return;
+  if(!original || !original->channels || original->abortFlag!=abortProvenance ||
+      original->nNodes!=1 || peer<0 || peer>=original->nRanks || peer==original->rank) {
