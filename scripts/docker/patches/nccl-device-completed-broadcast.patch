+/** @file llaminar_device_completion.h
+ * @brief Native original-stream receive evidence after every counted primitive.
+ * Included after native shared/primitive declarations; this is no separate kernel.
+ */
+#ifndef LLAMINAR_NATIVE_DEVICE_COMPLETION_H_
+#define LLAMINAR_NATIVE_DEVICE_COMPLETION_H_
+
+/** @brief Authenticate required device metadata before entering any native payload primitive.
+ * @param work Original shared native work and immutable metadata binding.
+ * @param tid Native work-group thread index; only its original writer publishes.
+ */
+__device__ __forceinline__ void ncclLlaminarBeginCompletionOperand(const volatile ncclLlaminarCompletionOperand* original, int tid, bool primary) {
+  if (!original || original->reserved || !original->table || !original->admission ||
+      !original->sequence || !original->message || !original->firstError || !original->receipt || original->failureCode <= 0 ||
+      reinterpret_cast<uintptr_t>(original->table) % alignof(uint64_t) ||
+      reinterpret_cast<uintptr_t>(original->admission) % alignof(uint64_t) ||
+      reinterpret_cast<uintptr_t>(original->sequence) % alignof(uint64_t) ||
+      reinterpret_cast<uintptr_t>(original->firstError) % alignof(int32_t) ||
+      reinterpret_cast<uintptr_t>(original->receipt) % alignof(ncclLlaminarByteCompletion) ||
+      (original->outgoingPayloadBytes && reinterpret_cast<uintptr_t>(original->outgoingPayloadBytes) % alignof(unsigned long long))) {
+#if defined(__HIP_DEVICE_COMPILE__)
+    __builtin_trap();
+#else
+    asm volatile("trap;");
+#endif
+  }
+  if (tid == 0) {
+    if (!*original->table || !*original->admission || !*original->sequence ||
+        ncclLlaminarAcquireAbort(ncclShmem.comm.abortFlag))
+      atomicCAS(original->firstError, 0, original->failureCode);
+    if (primary) {
+      auto* receipt = original->receipt;
+      // Only this original channel publishes a disposition. Every channel can
+      // veto it through the SAME sticky error after its own native primitives.
+      atomicExch(reinterpret_cast<unsigned int*>(&receipt->phase),
+          static_cast<unsigned int>(ncclLlaminarCompletionPhase::Pending));
+      receipt->table = *original->table;
+      receipt->admission = *original->admission;
+      receipt->sequence = *original->sequence;
