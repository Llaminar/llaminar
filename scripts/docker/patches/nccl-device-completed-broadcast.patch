+/**
+ * @brief Broadcast an original device-authored source slice through native transport.
+ * @param sendbuff Original root source bank, never a host-adjusted payload pointer.
+ * @param recvbuff Original destination bank with payloadCapacity bytes admitted.
+ * @param sourceSlice Original root offset/bytes descriptor; null on receivers.
+ * @param liveBytes Root descriptor's liveBytes field or receiver's admitted UINT64 extent.
+ * @param sourceCapacityBytes Exact admitted root subspan bytes; zero on receivers.
+ * @param sourceOffsetOrigin Immutable absolute origin of that subspan; zero on receivers.
+ * @param payloadCapacity Native worst-case progress bound, never useful wire bytes.
+ * @param root Exact original communicator coordinate, independent of device ordinal.
+ * @param completion Original device frame, sticky first-error and actual completion receipt.
+ * @param comm Original initialized node-local communicator.
+ * @param stream Exact original stream after descriptor publication.
+ * @return Native enqueue status; invalid device extents trap before payload mutation.
+ *
+ * Header and payload are separate real native plans. No host reads a device
+ * offset or count; only the root selects a source slice. All receivers acquire
+ * the same source-authored count before their zero-based payload receives.
+ */
+extern "C" __attribute__((visibility("default"))) ncclResult_t
+llaminarNcclBroadcastCompletedSliceOrigin(const void* sendbuff, void* recvbuff,
+    const ncclLlaminarSourceSlice* sourceSlice, uint64_t* liveBytes,
+    size_t sourceCapacityBytes, size_t payloadCapacity, int root, uint64_t sourceOffsetOrigin,
+    const ncclLlaminarCompletionOperand* completion, ncclComm_t comm, cudaStream_t stream) {
+  if (!sendbuff || !recvbuff || !liveBytes || !completion || !comm ||
+      reinterpret_cast<uintptr_t>(stream) <= 2 || !payloadCapacity || payloadCapacity > PTRDIFF_MAX ||
+      reinterpret_cast<uintptr_t>(liveBytes) % alignof(uint64_t) ||
+      (completion && reinterpret_cast<uintptr_t>(completion) % alignof(ncclLlaminarCompletionOperand)))
+    return ncclInvalidArgument;
+  if (ncclGroupDepth != 0) {
+    WARN("Device-slice broadcast requires separate native extent/payload plans; an outer group is invalid");
+    return ncclInvalidUsage;
+  }
+  int ranks;
+  NCCLCHECK(ncclCommCount(comm, &ranks));
+  if (ranks < 2 || comm->nNodes != 1 || root < 0 || root >= ranks) return ncclInvalidUsage;
+  const bool isRoot = comm->rank == root;
+  if (isRoot ? (!sourceSlice || !sourceCapacityBytes || sourceCapacityBytes < payloadCapacity || sourceCapacityBytes > PTRDIFF_MAX || sourceOffsetOrigin > UINT64_MAX - sourceCapacityBytes ||
+      reinterpret_cast<uintptr_t>(sourceSlice) % alignof(ncclLlaminarSourceSlice)) : (sourceSlice || sourceCapacityBytes || sourceOffsetOrigin))
+    return ncclInvalidArgument;
+  const uintptr_t a = reinterpret_cast<uintptr_t>(sendbuff);
+  const uintptr_t b = reinterpret_cast<uintptr_t>(recvbuff);
+  const uintptr_t c = reinterpret_cast<uintptr_t>(liveBytes);
+  const uintptr_t q = reinterpret_cast<uintptr_t>(completion);
+  const uintptr_t d = reinterpret_cast<uintptr_t>(sourceSlice);
+  const auto overlap = [](uintptr_t x, size_t xn, uintptr_t y, size_t yn) {
+    return x < y + yn && y < x + xn;
+  };
+  if (b > UINTPTR_MAX - payloadCapacity || c > UINTPTR_MAX - sizeof(uint64_t) ||
+      (q && q > UINTPTR_MAX - sizeof(ncclLlaminarCompletionOperand)) ||
+      (isRoot && (a > UINTPTR_MAX - sourceCapacityBytes || d > UINTPTR_MAX - sizeof(ncclLlaminarSourceSlice))))
+    return ncclInvalidArgument;
+  if (isRoot && c != d + offsetof(ncclLlaminarSourceSlice, liveBytes)) return ncclInvalidArgument;
+  // Root in-place names its original source bank and is send-only even for
+  // nonzero device offsets. Receivers remain zero-based; distinct root output
+  // explicitly requests the native local slice copy. Partial aliases reject.
+  if (overlap(c, sizeof(uint64_t), b, payloadCapacity) ||
+      (isRoot && ((a != b && overlap(a, sourceCapacityBytes, b, payloadCapacity)) ||
+          overlap(d, sizeof(ncclLlaminarSourceSlice), a, sourceCapacityBytes) ||
+          overlap(d, sizeof(ncclLlaminarSourceSlice), b, payloadCapacity))) ||
+      (q && (overlap(q, sizeof(ncclLlaminarCompletionOperand), c, sizeof(uint64_t)) ||
+          overlap(q, sizeof(ncclLlaminarCompletionOperand), b, payloadCapacity) ||
+          (isRoot && (overlap(q, sizeof(ncclLlaminarCompletionOperand), a, sourceCapacityBytes) ||
+              overlap(q, sizeof(ncclLlaminarCompletionOperand), d, sizeof(ncclLlaminarSourceSlice)))))))
+    return ncclInvalidArgument;
+  NCCLCHECK(ncclBroadcast(liveBytes, liveBytes, sizeof(uint64_t), ncclInt8, root, comm, stream));
+  ncclInfo info = {ncclFuncBroadcast, "BroadcastCompletedSlice", sendbuff,
+    recvbuff, payloadCapacity, ncclInt8, ncclSum, root, comm, stream,
+    BROADCAST_CHUNKSTEPS, BROADCAST_SLICESTEPS};
+  if (isRoot) {
+    info.llaminarPayload.binding.slice = {sourceSlice, uint64_t(sourceCapacityBytes), completion};
+    info.llaminarSourceOffsetOrigin = sourceOffsetOrigin;
+    info.llaminarPayload.kind = ncclLlaminarPayloadKind::CompletedSourceSlice;
+  } else {
+    info.llaminarPayload.binding.bytes = {liveBytes, uint64_t(payloadCapacity), completion};
+    info.llaminarPayload.kind = ncclLlaminarPayloadKind::CompletedBytes;
+  }
+  return ncclEnqueueCheck(&info);
+}
 
