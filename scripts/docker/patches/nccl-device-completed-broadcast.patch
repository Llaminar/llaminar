+        d > UINTPTR_MAX-sizeof(ncclLlaminarSourceSlice) ||
+        c != d+offsetof(ncclLlaminarSourceSlice,liveBytes) ||
+        overlap(d,sizeof(ncclLlaminarSourceSlice),a,bankBytes) ||
+        overlap(d,sizeof(ncclLlaminarSourceSlice),q,sizeof(ncclLlaminarCompletionOperand))) return ncclInvalidArgument;
+  } else if (sourceCapacityBytes || sourceOffsetOrigin) return ncclInvalidArgument;
+  // The existing fixed eight-byte peer operation publishes the actual sender
+  // extent first. No host dereference, capacity-sized header or extra owner.
+  if (sending) NCCLCHECK(ncclSend(liveBytes,sizeof(uint64_t),ncclInt8,peer,comm,stream));
+  else NCCLCHECK(ncclRecv(liveBytes,sizeof(uint64_t),ncclInt8,peer,comm,stream));
+  ncclInfo info = {sending ? ncclFuncSend : ncclFuncRecv, "AddressedCompletedBytes",
+    nullptr, payload, capacityBytes, ncclInt8, ncclSum, peer, comm, stream, 1, 1};
