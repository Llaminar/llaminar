+namespace {
+  template<typename T, typename RedOp, typename Proto, bool NodeLocal, int Mode>
+  __device__ __forceinline__ void runRingMode(int tid, int nthreads, struct ncclDevWorkColl* work) {
+    ncclRing *ring = &ncclShmem.channel.ring;
+    const int rank = ring->userRanks[0];
+    const int nextRank = ring->userRanks[1];
+    const int root = work->root;
+    ssize_t totalCount;
+    ssize_t chunkCount;
+    ssize_t channelCount;
+    ssize_t gridOffset;
+    ncclCollCbdPart(work, ncclShmem.channelId, Proto::Id, sizeof(T), &totalCount, &gridOffset, &channelCount, &chunkCount);
+    size_t offset;
+    int nelem;
+    int workNthreads;
+    const bool isNetOffload = !NodeLocal && work->isOneRPN && work->netRegUsed;
+    if ((Mode == int(ncclLlaminarPayloadKind::CompletedBytes) ||
+         Mode == int(ncclLlaminarPayloadKind::CompletedSourceSlice)) &&
+        (!work->oneNode || work->netRegUsed)) {
+#if defined(__HIP_DEVICE_COMPILE__)
+      __builtin_trap();
+#else
+      asm volatile("trap;");
+#endif
+    }
+
+    ncclLlaminarBeginCompletion(work, tid);
+    T *inputBuf = (T*)work->sendbuff;
+    T *outputBuf = (T*)work->recvbuff;
+    size_t sourceSliceEnd = ~size_t(0);
+    if (Mode == int(ncclLlaminarPayloadKind::CompletedSourceSlice)) {
+      // Only the actual root has a source-relative descriptor. Receivers retain
+      // the separately broadcast original UINT64 prefix and zero-based output.
+      if (rank != root || sizeof(T) != 1) {
+#if defined(__HIP_DEVICE_COMPILE__)
+        __builtin_trap();
+#else
+        asm volatile("trap;");
+#endif
+      }
+      const auto slice = ncclLlaminarResolveSourceSlice(work->llaminarPayload.binding.slice,
+          size_t(totalCount), work->llaminarSourceOffsetOrigin);
+      inputBuf += slice.byteOffset;
+      sourceSliceEnd = size_t(slice.liveBytes);
+    }
+
+    workNthreads = isNetOffload ? WARP_SIZE : nthreads;
+
+    if (tid < workNthreads) {
+      // Coverity reports that the callee treats &ring->next as an array.  However, due to the use of
+      // FanSymmetric<1>, only the first element is ever accessed, so it's fine.
+      // coverity[callee_ptr_arith:FALSE]
+      Primitives<T, RedOp, FanSymmetric<1>, 1, Proto, 0>
+        prims(tid, workNthreads, &ring->prev, &ring->next, inputBuf, outputBuf, work->redOpArg, 0, 0, 0, work);
+
+      for (size_t elemOffset = 0; elemOffset < channelCount; elemOffset += chunkCount) {
+        offset = gridOffset + elemOffset;
+        nelem = min(chunkCount, channelCount - elemOffset);
+        // Only useful payload narrows. Every original chunk and acknowledgement
+        // remains present, including empty slices on native SHM/proxy paths.
+        nelem = ncclLlaminarPayload<T, size_t, Mode>(work, tid, offset, nelem, nextRank == root ? 0 : 1, sourceSliceEnd);
+
+        if (rank == root) {
+          // Root in-place is defined by its ORIGINAL bank, before applying the
+          // device source origin. It sends only and never overwrites that bank.
+          if (work->sendbuff == work->recvbuff || isNetOffload) {
+            prims.directSend(offset, offset, nelem);
+          } else {
+            prims.directCopySend(offset, offset, nelem);
+          }
+        } else if (nextRank == root) {
+          prims.directRecv(offset, nelem);
+        } else {
+          prims.directRecvCopyDirectSend(offset, offset, nelem);
+        }
+      }
+    } else if (inputBuf != outputBuf && rank == root) {
+      inputBuf = inputBuf + gridOffset;
+      outputBuf = outputBuf + gridOffset;
+      reduceCopy<COLL_UNROLL, RedOp, T, 0, 1, 1, 0, 1, 1, /*PreOpSrcs=*/0>
+        (tid - workNthreads, nthreads - workNthreads, work->redOpArg, &work->redOpArg, false, 1, (void**)&inputBuf, 1, (void**)&outputBuf, channelCount);
+    }
+    if (isNetOffload) barrier_sync(14, nthreads);
+      ncclLlaminarFinishCompletion(work, tid,
+        Mode == int(ncclLlaminarPayloadKind::CompletedSourceSlice)
+            ? sourceSliceEnd : work->llaminarPayload.binding.resolved.liveBytes);
+}
