+  for(int channel=0;channel<MAXCHANNELS;++channel) {
+    uint64_t sent=0,received=0;
+    auto* rows=original->channels[channel].peers;
+    auto* endpoint=rows?rows[peer]:nullptr;
+    if(endpoint) {
+#pragma unroll 1
+      for(int connection=0;connection<NCCL_MAX_CONNS;++connection) {
+        sent+=endpoint->send[connection].step;
+        received+=endpoint->recv[connection].step;
+      }
+    }
+    channels[2*channel]=sent;
+    channels[2*channel+1]=received;
+    totalSent+=sent;totalReceived+=received;
+  }
+  output->sentSteps=totalSent;
+  output->receivedSteps=totalReceived;
