+/**
+ * @brief Leave the original native launch barrier, or propagate its original abort.
+ * @param comm Original initialized communicator; no gate or arrival is fabricated.
+ * @param reduction Receives the original barrier sum only on successful completion.
+ * @return Native failure on cancellation, before a kernel launch or success finish.
+ * This host-only out half retains the original counter/gate/phase protocol. A
+ * missing peer cannot be repaired by publishing a synthetic gate or contribution.
+ * Aborted communicators remain absorbing and are destroyed only after graph owners.
+ */
+static ncclResult_t ncclLlaminarIntraBarrierOutAbortable(ncclComm* comm, uint32_t* reduction) {
+  if (!comm || !reduction || !comm->intraComm0 || !comm->abortFlag) return ncclInternalError;
+  const auto aborted = [comm]() {
+    return __atomic_load_n(comm->abortFlag, __ATOMIC_ACQUIRE) != 0;
+  };
+  if (aborted()) return ncclInternalError;
+  ncclComm* comm0 = comm->intraComm0;
+  comm->intraBarrierPhase ^= 1;
+  const uint32_t phase = comm->intraBarrierPhase;
+  uint64_t gate = __atomic_load_n(&comm0->intraBarrierGate, __ATOMIC_RELAXED);
+  if ((gate & 1) != phase) {
+    const uint64_t t0 = clockNano();
+    do {
+      if (aborted()) return ncclInternalError;
+      if (clockNano() - t0 >= 5 * 1000) sched_yield();
+      gate = __atomic_load_n(&comm0->intraBarrierGate, __ATOMIC_RELAXED);
+    } while ((gate & 1) != phase);
+  }
+  if (comm->intraRanks != 1) __atomic_thread_fence(__ATOMIC_ACQUIRE);
+  if (aborted()) return ncclInternalError;
+  *reduction = uint32_t(gate >> 32);
+  return ncclSuccess;
+}
