 template<typename T, typename RedOp>
 struct RunWorkColl<ncclFuncBroadcast, T, RedOp, NCCL_ALGO_RING, NCCL_PROTO_SIMPLE> {
+  /** @brief Retain one capture-identity payload mode through the original Ring body. */
+  template<int Mode>
+  __device__ __forceinline__ void runNodeLocalMode(int tid, int nthreads, ncclDevWorkColl* work) {
+    using Proto = ProtoSimple<BROADCAST_CHUNKSTEPS/BROADCAST_SLICESTEPS, BROADCAST_SLICESTEPS>;
+    if constexpr (Mode == 0) {
+      runRingFixed<T, RedOp, Proto>(tid, nthreads, work);
+    } else {
+      runRingMode<T, RedOp, Proto, true, Mode>(tid, nthreads, work);
+    }
+  }
+
+  /** @brief Execute the original Ring primitive after whole-plan node-local admission. */
+  __device__ __forceinline__ void runNodeLocal(int tid, int nthreads, struct ncclDevWorkColl* work) {
+    using Proto = ProtoSimple<BROADCAST_CHUNKSTEPS/BROADCAST_SLICESTEPS, BROADCAST_SLICESTEPS>;
+    runRingFixed<T, RedOp, Proto>(tid, nthreads, work);
