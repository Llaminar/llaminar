+/**
+ * @file llaminar_p2p_launch.h
+ * @brief Seal actual native P2P batches, source work and selected connections.
+ *
+ * This transient planner proof owns no allocation or progress ledger. The
+ * serialized batches and native connector remain the sole work/transport
+ * authorities. Counted payloads require this direct entry; ordinary foreign
+ * native work retains its existing kernel and transport semantics.
+ */
+#ifndef NCCL_LLAMINAR_P2P_LAUNCH_H_
+#define NCCL_LLAMINAR_P2P_LAUNCH_H_
+#include "comm.h"
+#include "transport.h"
+#include <vector>
+
+/** @brief Whether the public API requires device-owned counted progress. */
+enum class ncclP2pLaunchRequirement { OrdinaryNative, DeviceCounted };
+/** @brief Complete outcome of validating the direct entry's physical inputs. */
+enum class ncclP2pLaunchStatus { Sealed, Empty, ForeignWork, Geometry, Connection };
+/** @brief Immutable publication result; invalid required work cannot launch. */
+struct ncclP2pLaunchSeal {
+  ncclP2pLaunchRequirement requirement;
+  ncclP2pLaunchStatus status;
+};
+
+/**
+ * @brief Resolve a serialized work offset against the actual retained source list.
+ * @param plan Native plan whose source list owns every published work byte.
+ * @param wanted Exact byte offset from the serialized batch.
+ * @return Exact P2P descriptor or null for interior, missing or foreign storage.
+ */
+inline ncclDevWorkP2p const* ncclLlaminarP2pWorkAt(ncclKernelPlan const* plan, size_t wanted) {
+  size_t offset = 0;
+  for (auto* node = plan->workQueue.head; node; node = node->next) {
+    if (node->size < 0 || offset > plan->workBytes || size_t(node->size) > plan->workBytes-offset) return nullptr;
+    if (offset == wanted)
+      return node->workType == ncclDevWorkTypeP2p && node->size == sizeof(ncclDevWorkP2p)
+          ? reinterpret_cast<ncclDevWorkP2p const*>(node+1) : nullptr;
+    offset += size_t(node->size);
+    if (offset > wanted) return nullptr;
+  }
+  return nullptr;
+}
+
+/**
+ * @brief Validate the active direction's actual connected device-progress transport.
+ * @param comm Fully connected native communicator.
+ * @param channel Actual channel selected by the serialized batch chain.
+ * @param peer Native work's actual peer rank.
+ * @param send Whether this is the send connector at native P2P connection index1.
+ * @return True only for selected local P2P/SHM without proxy/CE/network progress.
+ */
+inline bool ncclLlaminarP2pConnection(ncclComm const* comm, int channel, int peer, bool send) {
+  if (peer < 0 || peer >= comm->nRanks || channel < 0 || channel >= MAXCHANNELS ||
+      !comm->channels[channel].peers || !comm->channels[channel].peers[peer]) return false;
+  auto const* endpoint = comm->channels[channel].peers[peer];
+  auto const* conn = send ? &endpoint->send[1] : &endpoint->recv[1];
+  auto const* p2p = send ? &p2pTransport.send : &p2pTransport.recv;
+  auto const* shm = send ? &shmTransport.send : &shmTransport.recv;
+  return conn->connected && (conn->transportComm == p2p || conn->transportComm == shm) &&
+      !conn->proxyConn.proxyProgress && !conn->proxyConn.proxyGinProgress &&
+      !(conn->conn.flags & NCCL_DIRECT_NIC) && !conn->conn.netDeviceHandle.handle &&
+      conn->conn.netDeviceHandle.netDeviceType==NCCL_NET_DEVICE_HOST;
+}
+
+/**
+ * @brief Prove every channel chain, work reference and active connection before launch.
+ * @param comm Native communicator supplying actual physical-host and connector facts.
+ * @param plan Complete native source work/task inventory, before publication.
+ * @param batches Actual final channel-interleaved serialized batch array.
+ * @param count Exact array length.
+ * @return A typed seal; required DeviceCounted work fails if it is not Sealed.
+ *
+ * Eight warps support at most four works under the unchanged P2P scheduler.
+ * Extension batches are rejected because their fused count is not independent.
+ * All references resolve to actual source-list boundaries and every batch is
+ * visited exactly once through the same per-channel links the device replays.
+ */
+inline ncclP2pLaunchSeal ncclLlaminarSealP2pLaunch(ncclComm const* comm,
+    ncclKernelPlan const* plan, ncclDevWorkBatch const* batches, int count) {
+  ncclP2pLaunchRequirement requirement = ncclP2pLaunchRequirement::OrdinaryNative;
+  for (auto* task = plan->p2pTaskQueue.head; task; task = task->next) {
+    const auto& payload=task->llaminarTransfer.payload;
+    // Completion kind is required even for a malformed absent binding: it must
+    // never silently select the ordinary indirect entry without its receipt.
+    if (payload.active() || payload.kind==ncclLlaminarPayloadKind::CompletedBytes ||
+        payload.kind==ncclLlaminarPayloadKind::CompletedSourceSlice)
+      requirement=ncclP2pLaunchRequirement::DeviceCounted;
+  }
+  const auto reject = [&](ncclP2pLaunchStatus status) { return ncclP2pLaunchSeal{requirement,status}; };
+  if (count <= 0 || !plan->channelMask) return reject(ncclP2pLaunchStatus::Empty);
+  if (!batches || count != plan->nWorkBatches || comm->nNodes != 1 ||
+      comm->p2pnChannels <= 0 || comm->p2pnChannels > MAXCHANNELS ||
+      (comm->p2pnChannels & (comm->p2pnChannels-1)))
+    return reject(ncclP2pLaunchStatus::Geometry);
+  for (auto* node = plan->workQueue.head; node; node = node->next)
+    if (node->workType != ncclDevWorkTypeP2p || node->size != sizeof(ncclDevWorkP2p))
+      return reject(ncclP2pLaunchStatus::ForeignWork);
+  std::vector<unsigned char> visited(size_t(count),0);
+  int root = 0, seen = 0;
+  for (int channel=0; channel<MAXCHANNELS; ++channel) {
+    if (!(plan->channelMask & (uint64_t(1)<<channel))) continue;
+    int index = root++;
+    for (;;) {
+      if (index < 0 || index >= count || visited[index]) return reject(ncclP2pLaunchStatus::Geometry);
+      visited[index]=1; ++seen;
+      auto const& batch=batches[index];
+      if (batch.workType != ncclDevWorkTypeP2p || batch.funcId != ncclDevFuncId_P2p())
+        return reject(ncclP2pLaunchStatus::ForeignWork);
+      const int works=__builtin_popcountll(batch.offsetBitset);
+      if (batch.nextExtends || works<1 || works>NCCL_LLAMINAR_LOCAL_P2P_MAX_WORKS)
+        return reject(ncclP2pLaunchStatus::Geometry);
+      for (int bit=0; bit<64; ++bit) {
+        if (!(batch.offsetBitset & (uint64_t(1)<<bit))) continue;
+        const size_t offset=size_t(batch.offsetBase)+size_t(bit)*sizeof(ncclDevWorkP2p);
+        auto const* work=ncclLlaminarP2pWorkAt(plan,offset);
+        if (!work) return reject(ncclP2pLaunchStatus::ForeignWork);
+        if (work->sendNetReg || work->recvNetReg) return reject(ncclP2pLaunchStatus::Connection);
+        if (work->nP2pChannels!=comm->p2pnChannels || work->channelBase>=comm->p2pnChannels ||
+            work->nSendChannels>comm->p2pnChannels || work->nRecvChannels>comm->p2pnChannels)
+          return reject(ncclP2pLaunchStatus::Geometry);
+        const int part=(channel-work->channelBase)&(comm->p2pnChannels-1);
+        const bool send=part<work->nSendChannels, recv=part<work->nRecvChannels;
+        if (!send && !recv) return reject(ncclP2pLaunchStatus::Geometry);
+        if (work->sendRank==comm->rank) {
+          if (!send || !recv || work->recvRank!=comm->rank || work->sendBytes!=work->recvBytes)
+            return reject(ncclP2pLaunchStatus::Geometry);
+        } else if ((send && !ncclLlaminarP2pConnection(comm,channel,work->sendRank,true)) ||
+                   (recv && !ncclLlaminarP2pConnection(comm,channel,work->recvRank,false)))
+          return reject(ncclP2pLaunchStatus::Connection);
+      }
+      if (!batch.nextJump) break;
+      if (batch.nextJump > unsigned(count-1-index)) return reject(ncclP2pLaunchStatus::Geometry);
+      index += batch.nextJump;
+    }
+  }
+  return reject(seen==count ? ncclP2pLaunchStatus::Sealed : ncclP2pLaunchStatus::Geometry);
+}
+/**
+ * @brief Publish the proven entry and geometry atomically at the plan boundary.
+ * @param plan Native plan receiving its immutable captured launch identity.
+ * @param seal Result from the complete actual-input validator.
+ * @return InvalidUsage before mutation for foreign required work or absent entry.
+ * Ordinary unsealed native work retains its original kernel and geometry.
+ */
+inline ncclResult_t ncclLlaminarBindP2pLaunch(ncclKernelPlan* plan, ncclP2pLaunchSeal seal) {
+  if (seal.status!=ncclP2pLaunchStatus::Sealed)
+    return seal.requirement==ncclP2pLaunchRequirement::DeviceCounted ? ncclInvalidUsage : ncclSuccess;
+  if (ncclDevLocalP2pKernelIndex<0 || ncclDevLocalP2pKernelIndex>=ncclDevKernelCount ||
+      !ncclDevKernelList[ncclDevLocalP2pKernelIndex]) return ncclInvalidUsage;
+  plan->kernelFn=ncclDevKernelList[ncclDevLocalP2pKernelIndex];
+  plan->kernelSpecialized=true;
+  plan->threadPerBlock=NCCL_LLAMINAR_LOCAL_P2P_NTHREADS;
+  return ncclSuccess;
+}
+/**
+ * @brief Drain all unpublished owners if a later plan rejects before publication.
+ * @param planner Actual native queue containing earlier unpublished plans.
+ * @param rejected Complete current plan, not yet enqueued.
+ * @param retire Typed pending-phase retirement supplied by the native owner.
+ * @return First cleanup error after every owner has been visited exactly once.
+ *
+ * Native group cleanup assumes persistent queued plans already have graph
+ * references. At this earlier boundary no plan has acquired those references.
+ */
+template<class RetirePending>
+inline ncclResult_t ncclLlaminarRetirePendingP2pPlanSet(ncclKernelPlanner* planner,
+    ncclKernelPlan* rejected, RetirePending retire) {
+  ncclResult_t result=retire(rejected);
+  while (!ncclIntruQueueEmpty(&planner->planQueue)) {
+    auto* earlier=ncclIntruQueueDequeue(&planner->planQueue);
+    const auto status=retire(earlier);
+    if (result==ncclSuccess) result=status;
+  }
+  planner->unlaunchedPlansHead=nullptr;
+  return result;
+}
