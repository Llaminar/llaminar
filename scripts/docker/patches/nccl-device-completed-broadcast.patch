+/**
+ * @brief Enqueue one addressed completed byte operand on the original communicator.
+ * @param payload Exact local original payload bank; only the named peer consumes it.
+ * @param liveBytes Sender-owned UINT64 extent or receiver's existing acquired field.
+ * @param capacityBytes Retained progress bound, never a payload communication extent.
+ * @param sourceSlice Sender-only original absolute descriptor, otherwise null.
+ * @param sourceCapacityBytes Exact sender source subspan, zero for ordinary prefixes.
+ * @param sourceOffsetOrigin Immutable absolute source subspan origin.
+ * @param peer Original communicator coordinate of the opposite endpoint.
+ * @param sending True only for the original producer endpoint.
+ * @param completion Original local interval, sticky error and native receipt binding.
+ * @param comm Original node-local communicator, retained through terminal retirement.
+ * @param stream Exact explicit endpoint stream after original metadata publication.
+ * @return Native enqueue result; errors never select another transport or operation.
+ * Header and payload close separate native plans. All unrelated communicator
+ * members remain absent from both operations. Capacity steps retain only their
+ * required progress metadata when no useful bytes intersect that step.
+ */
+static ncclResult_t llaminarNcclAddressedCompleted(void* payload, uint64_t* liveBytes,
+    size_t capacityBytes, const ncclLlaminarSourceSlice* sourceSlice,
+    size_t sourceCapacityBytes, uint64_t sourceOffsetOrigin, int peer, bool sending,
+    const ncclLlaminarCompletionOperand* completion, ncclComm_t comm, cudaStream_t stream) {
+  if (!payload || !liveBytes || !completion || !comm ||
+      reinterpret_cast<uintptr_t>(stream) <= 2 || !capacityBytes || capacityBytes > PTRDIFF_MAX ||
+      reinterpret_cast<uintptr_t>(liveBytes) % alignof(uint64_t) ||
+      reinterpret_cast<uintptr_t>(completion) % alignof(ncclLlaminarCompletionOperand))
+    return ncclInvalidArgument;
+  if (ncclGroupDepth != 0) return ncclInvalidUsage;
+  int ranks;
+  NCCLCHECK(ncclCommCount(comm, &ranks));
+  if (ranks < 2 || comm->nNodes != 1 || peer < 0 || peer >= ranks || peer == comm->rank)
+    return ncclInvalidUsage;
+  const size_t bankBytes = sourceSlice ? sourceCapacityBytes : capacityBytes;
+  const uintptr_t a = reinterpret_cast<uintptr_t>(payload), c = reinterpret_cast<uintptr_t>(liveBytes);
+  const uintptr_t q = reinterpret_cast<uintptr_t>(completion), d = reinterpret_cast<uintptr_t>(sourceSlice);
+  if (a > UINTPTR_MAX-bankBytes || c > UINTPTR_MAX-sizeof(uint64_t) ||
+      q > UINTPTR_MAX-sizeof(ncclLlaminarCompletionOperand)) return ncclInvalidArgument;
+  const auto overlap = [](uintptr_t x,size_t xn,uintptr_t y,size_t yn){return x < y+yn && y < x+xn;};
+  if (overlap(a,bankBytes,c,sizeof(uint64_t)) || overlap(a,bankBytes,q,sizeof(ncclLlaminarCompletionOperand)) ||
+      overlap(c,sizeof(uint64_t),q,sizeof(ncclLlaminarCompletionOperand))) return ncclInvalidArgument;
+  if (sourceSlice) {
+    if (!sending || !sourceCapacityBytes || sourceCapacityBytes < capacityBytes || sourceCapacityBytes > PTRDIFF_MAX ||
