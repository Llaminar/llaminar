#!/usr/bin/env bash
# Llaminar pre-commit gate: complete Unit and model-free production preflight.
# CMake owns both executable inventories; CTest owns test selection, resource
# locks, and timeouts. No model campaign, E2E server, or benchmark runs here.
# Register with: git config --local core.hooksPath .githooks
# An explicit `git commit --no-verify` bypasses this hook.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
BUILD_DIR="$REPO_ROOT/build_v2_integration"
LLAMINAR_NINJA_BIN="$(command -v ninja)"

echo '[pre-commit] Configuring the Integration build...'
# Resolve the active devcontainer Ninja once; never switch executables on an
# existing tree implicitly. Preserve unrelated cached ISA/toolchain options.
cmake -B "$BUILD_DIR" -S "$REPO_ROOT/src/v2" -G Ninja \
    -DCMAKE_BUILD_TYPE=Integration \
    -DCMAKE_MAKE_PROGRAM:FILEPATH="$LLAMINAR_NINJA_BIN" \
    -DLLAMINAR_BUILD_TESTS=ON -DHAVE_CUDA=ON -DHAVE_ROCM=ON

echo '[pre-commit] Building only Unit and production-preflight dependencies...'
cmake --build "$BUILD_DIR" --parallel \
    --target v2_unit_gate v2_production_parity_preflight_gate

echo '[pre-commit] [1/2] Running the full Unit suite...'
ctest --test-dir "$BUILD_DIR" --output-on-failure --parallel \
    --no-tests=error -R '^V2_Unit_'

echo '[pre-commit] [2/2] Running the full ProductionParityPreflight suite...'
ctest --test-dir "$BUILD_DIR" --output-on-failure --parallel \
    --no-tests=error -L '^ProductionParityPreflight$'

echo '[pre-commit] Unit and ProductionParityPreflight passed.'
