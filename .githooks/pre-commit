#!/usr/bin/env bash
# @file pre-commit
# @brief Build and run Llaminar's complete Unit gate before a commit.
# CMake owns the executable inventory. CTest owns test selection, resource
# locks, and timeouts.
# Register with: git config --local core.hooksPath .githooks
# An explicit `git commit --no-verify` bypasses this hook.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
# Git exports repository-local variables to hooks. Clear that inherited
# authority before CMake or tests inspect an independent dependency checkout.
# Resolve our root first; all subsequent local commands run from this directory.
LLAMINAR_HOOK_GIT_ENV="$(git rev-parse --local-env-vars)"
while IFS= read -r LLAMINAR_HOOK_GIT_VARIABLE; do
    unset "$LLAMINAR_HOOK_GIT_VARIABLE"
done <<< "$LLAMINAR_HOOK_GIT_ENV"
BUILD_DIR="${LLAMINAR_PRECOMMIT_BUILD_DIR:-$REPO_ROOT/build_v2_integration}"

LLAMINAR_NINJA_BIN="$(command -v ninja)"

echo '[pre-commit] Configuring the Integration build...'
# Resolve the active devcontainer Ninja once; never switch executables on an
# existing tree implicitly. Preserve unrelated cached ISA/toolchain options.
# Regenerate compiler metadata even after CMake resets a changed toolchain's
# cache. SDK/flag audits must inspect this build, never a surviving old JSON.
cmake -B "$BUILD_DIR" -S "$REPO_ROOT/src/v2" -G Ninja \
    -DCMAKE_BUILD_TYPE=Integration \
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
    -DCMAKE_MAKE_PROGRAM:FILEPATH="$LLAMINAR_NINJA_BIN" \
    -DLLAMINAR_BUILD_TESTS=ON -DHAVE_CUDA=ON -DHAVE_ROCM=ON

echo '[pre-commit] Building Unit dependencies...'
cmake --build "$BUILD_DIR" --parallel --target v2_unit_gate

echo '[pre-commit] Running the full Unit suite...'
ctest --test-dir "$BUILD_DIR" --output-on-failure --parallel \
    --no-tests=error -R '^V2_Unit_'

echo '[pre-commit] Unit suite passed.'
