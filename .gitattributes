# NativeVNNI corpus payloads are immutable benchmark evidence. Keep the small
# corpus manifest itself in ordinary Git so reviews can inspect its digests and
# provenance, while Git LFS owns the large timing, profiler, and trace payloads.
benchmark_results/native_vnni_dispatch/corpora/**/*.csv filter=lfs diff=lfs merge=lfs -text
benchmark_results/native_vnni_dispatch/corpora/**/*.csv.zst filter=lfs diff=lfs merge=lfs -text
benchmark_results/native_vnni_dispatch/corpora/**/*.json filter=lfs diff=lfs merge=lfs -text
benchmark_results/native_vnni_dispatch/corpora/**/*.jsonl filter=lfs diff=lfs merge=lfs -text
benchmark_results/native_vnni_dispatch/corpora/**/*.log filter=lfs diff=lfs merge=lfs -text
benchmark_results/native_vnni_dispatch/corpora/**/*.txt filter=lfs diff=lfs merge=lfs -text
benchmark_results/native_vnni_dispatch/corpora/**/*.ncu-rep filter=lfs diff=lfs merge=lfs -text
benchmark_results/native_vnni_dispatch/corpora/**/*.nsys-rep filter=lfs diff=lfs merge=lfs -text
benchmark_results/native_vnni_dispatch/corpora/**/*.pftrace filter=lfs diff=lfs merge=lfs -text
benchmark_results/native_vnni_dispatch/corpora/**/*.rpd filter=lfs diff=lfs merge=lfs -text
benchmark_results/native_vnni_dispatch/corpora/**/*.sqlite filter=lfs diff=lfs merge=lfs -text
benchmark_results/native_vnni_dispatch/corpora/**/*.tar.zst filter=lfs diff=lfs merge=lfs -text
# Keep the small reviewable identity/provenance document in ordinary Git.
benchmark_results/native_vnni_dispatch/corpora/**/corpus.manifest.json -filter -diff -merge text
