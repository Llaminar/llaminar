/**
 * @file PrefillGraphBuckets.def
 * @brief Single-source inventory of captured ordinary-prefill row buckets.
 *
 * The runtime graph cache and offline dispatch trainers both consume this file.
 * Serving selects its default bounded prefix through PrefillGraphBucketDefaults;
 * trainers retain this complete inventory, including explicit larger shapes.
 * Keep one `LLAMINAR_PREFILL_GRAPH_BUCKET` invocation per physical graph bucket;
 * long prompts are chunked through these captures and therefore do not create
 * larger kernel-dispatch buckets. CUDA and ROCm retain the same ladder; the
 * 448-row boundary lets the prefix before a 64-row checkpoint tail execute
 * without padding to 512 rows or increasing maximum arena capacity.
 */

LLAMINAR_PREFILL_GRAPH_BUCKET(64)
LLAMINAR_PREFILL_GRAPH_BUCKET(128)
LLAMINAR_PREFILL_GRAPH_BUCKET(256)
LLAMINAR_PREFILL_GRAPH_BUCKET(384)
LLAMINAR_PREFILL_GRAPH_BUCKET(448)
LLAMINAR_PREFILL_GRAPH_BUCKET(512)
LLAMINAR_PREFILL_GRAPH_BUCKET(544)
LLAMINAR_PREFILL_GRAPH_BUCKET(576)
LLAMINAR_PREFILL_GRAPH_BUCKET(600)
LLAMINAR_PREFILL_GRAPH_BUCKET(608)
LLAMINAR_PREFILL_GRAPH_BUCKET(640)
LLAMINAR_PREFILL_GRAPH_BUCKET(672)
LLAMINAR_PREFILL_GRAPH_BUCKET(704)
LLAMINAR_PREFILL_GRAPH_BUCKET(736)
LLAMINAR_PREFILL_GRAPH_BUCKET(768)
LLAMINAR_PREFILL_GRAPH_BUCKET(1024)
LLAMINAR_PREFILL_GRAPH_BUCKET(1280)
LLAMINAR_PREFILL_GRAPH_BUCKET(1536)
LLAMINAR_PREFILL_GRAPH_BUCKET(2048)
LLAMINAR_PREFILL_GRAPH_BUCKET(2560)
LLAMINAR_PREFILL_GRAPH_BUCKET(3072)
LLAMINAR_PREFILL_GRAPH_BUCKET(4096)
